        (rules.size() <= 72 || validPublicClosureRule(rules[72])) && (rules.size() <= 73 || validPublicClosureRule(rules[73])) &&
        (rules.size() <= 74 || validPublicClosureRule(rules[74])) && (rules.size() <= 75 || validPublicClosureRule(rules[75])) &&
        (rules.size() <= 76 || validPublicClosureRule(rules[76])) && (rules.size() <= 77 || validPublicClosureRule(rules[77])) &&

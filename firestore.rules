    // Existing public projections may retain a booking object created before
    // closureRules was introduced. New booking saves use the canonical shape.
    function validPublicBookingSettings(settings) {
      return (settings is map && settings.keys().hasAll([
          'minimumNoticeMinutes', 'bookingHorizonDays', 'slotIntervalMinutes', 'exceptionalClosures', 'closureRules', 'customerFields', 'productSelectionEnabled'
        ]) && settings.keys().hasOnly([
          'minimumNoticeMinutes', 'bookingHorizonDays', 'slotIntervalMinutes', 'exceptionalClosures', 'closureRules', 'customerFields', 'productSelectionEnabled'
        ]) && settings.minimumNoticeMinutes is int && settings.minimumNoticeMinutes >= 0 &&
        settings.bookingHorizonDays is int && settings.bookingHorizonDays >= 1 &&
        settings.slotIntervalMinutes is int && settings.slotIntervalMinutes >= 5 && settings.slotIntervalMinutes <= 120 &&
        settings.exceptionalClosures is list && settings.exceptionalClosures.size() == 0 && validPublicClosureRules(settings.closureRules) &&
        validBookingCustomerFields(settings.customerFields) && settings.productSelectionEnabled is bool) ||
        (settings is map && settings.keys().hasAll([
          'minimumNoticeMinutes', 'bookingHorizonDays', 'slotIntervalMinutes', 'exceptionalClosures'
        ]) && settings.keys().hasOnly([
          'minimumNoticeMinutes', 'bookingHorizonDays', 'slotIntervalMinutes', 'exceptionalClosures'
        ]) && settings.minimumNoticeMinutes is int && settings.minimumNoticeMinutes >= 0 &&
        settings.bookingHorizonDays is int && settings.bookingHorizonDays >= 1 &&
        settings.slotIntervalMinutes is int && settings.slotIntervalMinutes >= 5 && settings.slotIntervalMinutes <= 120 &&
        settings.exceptionalClosures is list && settings.exceptionalClosures.size() == 0);
    }

    // Legacy public projections did not carry customer fields. They request no
    // extra personal data until an administrator saves the canonical settings.
    function publicCustomerFieldState(barberId, field) {
      let business = get(/databases/$(database)/documents/publicBusinesses/$(barberId));
      return business.data.keys().hasAll(['config']) && business.data.config is map &&
        business.data.config.keys().hasAll(['booking']) && business.data.config.booking is map &&
        business.data.config.booking.keys().hasAll(['customerFields']) &&
        validBookingCustomerFields(business.data.config.booking.customerFields)
        ? business.data.config.booking.customerFields[field]
        : 'disabled';
    }

    function publicBookingRequestsAdditionalData(barberId) {
      return publicCustomerFieldState(barberId, 'email') != 'disabled' ||
        publicCustomerFieldState(barberId, 'address') != 'disabled';
    }

    function validRequestedAppointmentField(field, state, maxLength) {
      return (state == 'disabled' && !request.resource.data.keys().hasAny([field])) ||
        (state == 'optional' && (!request.resource.data.keys().hasAny([field]) ||
          (request.resource.data[field] is string && request.resource.data[field].size() > 0 && request.resource.data[field].size() <= maxLength))) ||
        (state == 'required' && request.resource.data.keys().hasAll([field]) &&
          request.resource.data[field] is string && request.resource.data[field].size() > 0 && request.resource.data[field].size() <= maxLength);
    }

    function validPublicBookingPrivacyConsent(barberId) {
      return !publicBookingRequestsAdditionalData(barberId)
        ? !request.resource.data.keys().hasAny(['bookingPrivacyConsent'])
        : request.resource.data.keys().hasAll(['bookingPrivacyConsent']) &&
          request.resource.data.bookingPrivacyConsent is map &&
          request.resource.data.bookingPrivacyConsent.keys().hasAll(['version', 'acceptedAt']) &&
          request.resource.data.bookingPrivacyConsent.keys().hasOnly(['version', 'acceptedAt']) &&
          request.resource.data.bookingPrivacyConsent.version == '2026-08-01' &&
          request.resource.data.bookingPrivacyConsent.acceptedAt == request.time;
    }

    // Product requests are informational only. Public callers are handled by
    // the trusted booking function because Rules cannot prove dynamic product
    // membership. This remains a defense-in-depth shape check for privileged
    // writers that create appointments.
    function publicProductSelectionEnabled(barberId) {
      let business = get(/databases/$(database)/documents/publicBusinesses/$(barberId));
      return business.data.keys().hasAll(['config']) && business.data.config is map &&
        business.data.config.keys().hasAll(['booking']) && business.data.config.booking is map &&
        business.data.config.booking.keys().hasAll(['productSelectionEnabled']) &&
        business.data.config.booking.productSelectionEnabled == true;
    }

    function validRequestedProduct(product) {
      return product is map && product.keys().hasOnly(['productId', 'name', 'quantity']) &&
        product.keys().hasAll(['productId', 'name', 'quantity']) &&
        product.productId is string && product.productId.size() > 0 && product.productId.size() <= 150 &&
        product.name is string && product.name.size() > 0 && product.name.size() <= 120 &&
        product.quantity is int && product.quantity >= 1 && product.quantity <= 10;
    }

    // Rules have no list quantifier. Public writes are denied and the callable
    // verifies source membership, while this bounded check keeps the shape
    // strict for privileged writers too.
    function validRequestedProductList(products) {
      return products is list && products.size() <= 10 &&
        (products.size() <= 0 || validRequestedProduct(products[0])) &&
        (products.size() <= 1 || validRequestedProduct(products[1])) &&
        (products.size() <= 2 || validRequestedProduct(products[2])) &&
        (products.size() <= 3 || validRequestedProduct(products[3])) &&
        (products.size() <= 4 || validRequestedProduct(products[4])) &&
        (products.size() <= 5 || validRequestedProduct(products[5])) &&
        (products.size() <= 6 || validRequestedProduct(products[6])) &&
        (products.size() <= 7 || validRequestedProduct(products[7])) &&
        (products.size() <= 8 || validRequestedProduct(products[8])) &&
        (products.size() <= 9 || validRequestedProduct(products[9]));
    }

    function validRequestedProducts(barberId) {
      return (!publicProductSelectionEnabled(barberId) && !request.resource.data.keys().hasAny(['requestedProducts'])) ||
        (publicProductSelectionEnabled(barberId) && (!request.resource.data.keys().hasAny(['requestedProducts']) ||
          validRequestedProductList(request.resource.data.requestedProducts)));
    }

    function bookingPrivacyConsentUnchanged() {
      return (!resource.data.keys().hasAny(['bookingPrivacyConsent']) &&
          !request.resource.data.keys().hasAny(['bookingPrivacyConsent'])) ||
        (resource.data.keys().hasAll(['bookingPrivacyConsent']) &&
          request.resource.data.keys().hasAll(['bookingPrivacyConsent']) &&
          request.resource.data.bookingPrivacyConsent == resource.data.bookingPrivacyConsent);
    }

    function businessBookingSettingsUnchangedOrValid() {
      // Keep this additive for legacy root records: a business without config,
      // or a config update that does not add/change booking, remains writable.
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['config']) ||
        !request.resource.data.keys().hasAny(['config']) ||
        !request.resource.data.config.keys().hasAny(['booking']) ||
        (resource.data.keys().hasAny(['config']) && resource.data.config.keys().hasAny(['booking']) &&
          request.resource.data.config.booking == resource.data.config.booking) ||
        validBookingSettings(request.resource.data.config.booking);
    }

    // This projection is the sole anonymous source for business presentation
    // and booking policy. Its allowlist deliberately excludes owner, billing,
    // trial, plan, limits, and every other internal field in `barbers/{id}`.
    function validGoogleMapsUrl(url) {
      return url is string && (
        url.matches('^https://www\\.google\\.com/maps/place/.+') ||
        url.matches('^https://maps\\.google\\.com/maps/place/.+')
      );
    }

    function validBusinessLocation(location) {
      return location is map && location.keys().hasAll(['latitude', 'longitude']) &&
        location.keys().hasOnly(['latitude', 'longitude']) &&
        location.latitude is number && location.longitude is number &&
        location.latitude >= -90 && location.latitude <= 90 &&
        location.longitude >= -180 && location.longitude <= 180;
    }

    function publicBusinessSlugMatchesRoot(barberId) {
      return request.resource.data.slug == getAfter(/databases/$(database)/documents/barbers/$(barberId)).data.slug;
    }

    // Presentation-only saves do not change the immutable public slug or the
    // operational mirror. Avoid a cross-document `getAfter` evaluation for
    // those writes, while retaining the after-state parity check whenever
    // either protected public field changes.
    function publicBusinessSlugUnchangedOrMatchesRootAfter(barberId) {
      return request.resource.data.slug == resource.data.slug ||
        publicBusinessSlugMatchesRoot(barberId);
    }

    function publicOperationalStateUnchangedOrMatchesRootAfter(barberId) {
      return (request.resource.data.active == resource.data.active &&
          ((!request.resource.data.keys().hasAny(['bookingEnabledUntil']) &&
              !resource.data.keys().hasAny(['bookingEnabledUntil'])) ||
            (request.resource.data.keys().hasAll(['bookingEnabledUntil']) &&
              resource.data.keys().hasAll(['bookingEnabledUntil']) &&
              request.resource.data.bookingEnabledUntil == resource.data.bookingEnabledUntil))) ||
        publicOperationalStateMatchesRootAfter(barberId);
    }

    function validPublicBusiness() {
      return request.resource.data.keys().hasAll(['name', 'slug', 'businessType', 'active', 'config', 'workingHours']) &&
        request.resource.data.keys().hasOnly(['name', 'slug', 'businessType', 'active', 'bookingEnabledUntil', 'config', 'workingHours']) &&
        request.resource.data.name is string && request.resource.data.slug is string &&
        request.resource.data.businessType is string && request.resource.data.active is bool &&
        (!request.resource.data.keys().hasAny(['bookingEnabledUntil']) || request.resource.data.bookingEnabledUntil is timestamp) &&
        request.resource.data.config is map && request.resource.data.config.keys().hasAll(['address', 'phone']) &&
        request.resource.data.config.keys().hasOnly(['address', 'phone', 'logoUrl', 'coverUrl', 'placeUrl', 'location', 'socialLinks', 'theme', 'booking']) &&
        (!request.resource.data.config.keys().hasAny(['booking']) || validPublicBookingSettings(request.resource.data.config.booking)) &&
        (!request.resource.data.config.keys().hasAny(['placeUrl']) || validGoogleMapsUrl(request.resource.data.config.placeUrl)) &&
        (!request.resource.data.config.keys().hasAny(['location']) || validBusinessLocation(request.resource.data.config.location)) &&
        validWorkingHours(request.resource.data.workingHours);
    }

    // Browser booking writes are denied below. The callable function is the
    // authoritative boundary for schedule policy, source-product membership,
    // and every deterministic lock. These checks protect privileged writers.
    function validPublicAppointment(barberId, appointmentId) {
      return request.resource.data.keys().hasAll([
          'clientName', 'clientPhone', 'serviceId', 'extraServices',
          'bookingDate', 'startTime', 'endTime', 'occupiedIntervalIds',
          'primaryLockId', 'status', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'clientName', 'clientPhone', 'barberId', 'serviceId', 'extraServices',
          'bookingDate', 'startTime', 'endTime', 'occupiedIntervalIds',
          'primaryLockId', 'status', 'notes', 'customerUid', 'createdAt', 'assignmentState', 'capacityStaffId',
           'clientEmail', 'clientAddress', 'bookingPrivacyConsent', 'requestedProducts'
        ]) &&
        request.resource.data.clientName is string && request.resource.data.clientName.size() > 0 && request.resource.data.clientName.size() <= 120 &&
        request.resource.data.clientPhone is string && request.resource.data.clientPhone.size() > 0 && request.resource.data.clientPhone.size() <= 40 &&
        validRequestedAppointmentField('clientEmail', publicCustomerFieldState(barberId, 'email'), 254) &&
        validRequestedAppointmentField('clientAddress', publicCustomerFieldState(barberId, 'address'), 240) &&
        validPublicBookingPrivacyConsent(barberId) &&
        validRequestedProducts(barberId) &&
        (!request.resource.data.keys().hasAll(['notes']) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 500)) &&
        request.resource.data.serviceId is string && request.resource.data.serviceId.size() > 0 &&
        request.resource.data.extraServices is list && request.resource.data.extraServices.size() == 0 &&
        request.resource.data.bookingDate is string && request.resource.data.bookingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.startTime is string && request.resource.data.startTime.matches('^[0-2][0-9]:[0-5][0-9]$') &&
        request.resource.data.endTime is string && request.resource.data.endTime.matches('^[0-2][0-9]:[0-5][0-9]$') &&
        request.resource.data.occupiedIntervalIds is list && request.resource.data.occupiedIntervalIds.size() > 0 && request.resource.data.occupiedIntervalIds.size() <= 19 &&
        request.resource.data.primaryLockId is string && request.resource.data.occupiedIntervalIds.hasAny([request.resource.data.primaryLockId]) &&
        request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time &&
        (!request.resource.data.keys().hasAll(['customerUid']) ||
          (isSignedIn() && request.resource.data.customerUid is string && request.resource.data.customerUid == request.auth.uid)) &&
        (
          (!request.resource.data.keys().hasAny(['assignmentState', 'capacityStaffId']) &&
            request.resource.data.barberId is string && request.resource.data.barberId.size() > 0 &&
            getAfter(/databases/$(database)/documents/barbers/$(barberId)/bookingLocks/$(request.resource.data.bookingDate)/staff/$(request.resource.data.barberId)/intervals/$(request.resource.data.primaryLockId)).data.appointmentId == appointmentId) ||
          (request.resource.data.keys().hasAll(['assignmentState', 'capacityStaffId']) &&
            request.resource.data.assignmentState == 'unassigned' &&
            request.resource.data.capacityStaffId is string && request.resource.data.capacityStaffId.size() > 0 &&
            !request.resource.data.keys().hasAny(['barberId']) &&
            getAfter(/databases/$(database)/documents/barbers/$(barberId)/bookingLocks/$(request.resource.data.bookingDate)/staff/$(request.resource.data.capacityStaffId)/intervals/$(request.resource.data.primaryLockId)).data.appointmentId == appointmentId)
        );
    }

    function validPublicBookingLock(barberId, bookingDate, staffId, intervalId) {
      let appointment = getAfter(/databases/$(database)/documents/barbers/$(barberId)/appointments/$(request.resource.data.appointmentId));
      return request.resource.data.keys().hasOnly(['appointmentId', 'bookingDate', 'staffId', 'intervalId', 'startTime', 'endTime', 'createdAt']) &&
        request.resource.data.keys().hasAll(['appointmentId', 'bookingDate', 'staffId', 'intervalId', 'startTime', 'endTime', 'createdAt']) &&
        request.resource.data.appointmentId is string && request.resource.data.appointmentId.size() > 0 &&
        request.resource.data.bookingDate == bookingDate && request.resource.data.staffId == staffId && request.resource.data.intervalId == intervalId &&
        request.resource.data.startTime is string && request.resource.data.startTime.matches('^[0-2][0-9]:[0-5][0-9]$') &&
        request.resource.data.endTime is string && request.resource.data.endTime.matches('^[0-2][0-9]:[0-5][0-9]$') &&
        request.resource.data.createdAt == request.time &&
        ((appointment.data.keys().hasAll(['assignmentState', 'capacityStaffId']) &&
            appointment.data.assignmentState == 'unassigned' && appointment.data.capacityStaffId == staffId) ||
          (!appointment.data.keys().hasAll(['assignmentState']) && appointment.data.barberId == staffId)) &&
        appointment.data.bookingDate == bookingDate &&
        appointment.data.occupiedIntervalIds.hasAny([intervalId]);
    }

    function serviceAllowsStaff(barberId, serviceId, staffId) {
      let serviceDoc = get(/databases/$(database)/documents/barbers/$(barberId)/services/$(serviceId));
      return serviceDoc.data.active == true &&
        (!serviceDoc.data.keys().hasAll(['staffIds']) || serviceDoc.data.staffIds.hasAny([staffId]));
    }

    // A claim has one allowed direction: an authenticated active Staff member
    // assigns an unassigned pending appointment to their own staff profile.
    function staffCanClaimUnassignedAppointment(barberId) {
      let staffId = currentUserDoc().data.staffId;
      return isOperationalBusinessStaff(barberId) && resource.data.keys().hasAll(['assignmentState', 'capacityStaffId']) && resource.data.assignmentState == 'unassigned' &&
        resource.data.capacityStaffId is string && resource.data.status in ['pending', 'confirmed'] &&
        request.resource.data.assignmentState == 'assigned' && request.resource.data.barberId == staffId &&
        !request.resource.data.keys().hasAny(['capacityStaffId']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignmentState', 'barberId', 'capacityStaffId', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time && serviceAllowsStaff(barberId, resource.data.serviceId, staffId);
    }

    // Capacity locks are moved only in the same claim transaction. They never
    // contain client data, and the capacity identity is never projected public.
    function validClaimLockCreate(barberId, bookingDate, staffId, intervalId) {
      let appointmentBefore = get(/databases/$(database)/documents/barbers/$(barberId)/appointments/$(request.resource.data.appointmentId));
      let appointmentAfter = getAfter(/databases/$(database)/documents/barbers/$(barberId)/appointments/$(request.resource.data.appointmentId));
      return isOperationalBusinessStaff(barberId) && currentUserDoc().data.staffId == staffId &&
        request.resource.data.keys().hasOnly(['appointmentId', 'bookingDate', 'staffId', 'intervalId', 'startTime', 'endTime', 'createdAt']) &&
        request.resource.data.appointmentId is string && request.resource.data.bookingDate == bookingDate &&
        request.resource.data.staffId == staffId && request.resource.data.intervalId == intervalId && request.resource.data.createdAt == request.time &&
        appointmentBefore.data.assignmentState == 'unassigned' && appointmentAfter.data.assignmentState == 'assigned' &&
        appointmentAfter.data.barberId == staffId && appointmentAfter.data.occupiedIntervalIds.hasAny([intervalId]);
    }

    function validClaimLockDelete(barberId, bookingDate, staffId, intervalId) {
      let appointmentBefore = get(/databases/$(database)/documents/barbers/$(barberId)/appointments/$(resource.data.appointmentId));
      let appointmentAfter = getAfter(/databases/$(database)/documents/barbers/$(barberId)/appointments/$(resource.data.appointmentId));
      return isOperationalBusinessStaff(barberId) && currentUserDoc().data.staffId == appointmentAfter.data.barberId &&
        resource.data.bookingDate == bookingDate && resource.data.staffId == staffId && resource.data.intervalId == intervalId &&
        appointmentBefore.data.assignmentState == 'unassigned' && appointmentBefore.data.capacityStaffId == staffId &&
        appointmentAfter.data.assignmentState == 'assigned' && appointmentAfter.data.occupiedIntervalIds.hasAny([intervalId]);
    }

    function validOptionalContentDescription() {
      return !request.resource.data.keys().hasAny(['description']) ||
        (request.resource.data.description is string && request.resource.data.description.size() <= 500);
    }

    function validInitialLegalConsent() {
      return request.resource.data.keys().hasAll(['legalConsent']) &&
        request.resource.data.legalConsent is map &&
        request.resource.data.legalConsent.keys().hasAll(['version', 'acceptedAt']) &&
        request.resource.data.legalConsent.keys().hasOnly(['version', 'acceptedAt']) &&
        request.resource.data.legalConsent.version == '2026-07-31' &&
        request.resource.data.legalConsent.acceptedAt == request.time;
    }

    function legalConsentUnchangedOrAbsentOnLegacyProfile() {
      return (!resource.data.keys().hasAll(['legalConsent']) &&
          (!request.resource.data.keys().hasAll(['legalConsent']) || validInitialLegalConsent())) ||
        (resource.data.keys().hasAll(['legalConsent']) &&
          request.resource.data.keys().hasAll(['legalConsent']) &&
          request.resource.data.legalConsent == resource.data.legalConsent);
    }

    // Users collection
    match /users/{uid} {
      // Superadmin puede leer todo
      allow read: if isSuperAdmin() || (isSignedIn() && request.auth.uid == uid);

      // Registro inicial: cada usuario solo puede crearse como customer.
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role == 'customer' && validInitialLegalConsent();

      // Superadmin puede cambiar roles y vínculos de negocio/personal.
      // Usuario normal puede actualizar perfil, pero no role ni vínculos.
      // A Superadmin may manage other accounts, but cannot alter their own
      // global role through a business-creation transaction or direct update.
      allow update: if legalConsentUnchangedOrAbsentOnLegacyProfile() && ((isSuperAdmin() &&
                          (request.auth.uid != uid ||
                            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))) ||
                            validDirectEnrollmentUserUpdate(uid) || validEnrollmentProofRemoval(uid) ||
                            validStoreadminOwnProfileLink(uid) || validProfessionalRetirementUser(uid) || validStoreadminProfessionalUnlink() ||
                            (isSignedIn() && request.auth.uid == uid &&
                              !request.resource.data.diff(resource.data).changedKeys().hasAny(['role', 'businessIds', 'staffId', 'professionalBusinessId', 'enrollmentCode'])));

      allow delete: if isSuperAdmin();
    }

    // Root businesses contain owner and billing data. They are never public.
    match /barbers/{barberId} {
      allow read: if isSuperAdmin();
      allow delete: if isSuperAdmin() && publicProjectionRemovedAfterRootDelete(barberId);
      // `ownerId` is descriptive metadata, never an authorization grant. A
      // created or reassigned owner must also be a Storeadmin member.
      allow create: if isSuperAdmin() && validBusinessOwnerAssignment(barberId) &&
        validWorkingHours(request.resource.data.workingHours) && publicOperationalStateMatchesRootAfter(barberId);
      
      // Root records include subscription and platform fields, so only platform
      // administrators can read them. Scoped clients may still update the
      // strictly allowlisted operational fields below.
      allow update: if ((isSuperAdmin() && ownerAssignmentUnchangedOrValid(barberId) && businessWorkingHoursUnchangedOrValid() && businessBookingSettingsUnchangedOrValid()) ||
        (isOperationalBusinessAdmin(barberId) && businessAdminCanUpdateBusiness())) &&
        operationalFieldsUnchangedOrPublicProjectionSynced(barberId);
      
      // Subcolecciones
      match /services/{serviceId} {
        // Public booking services are allowlisted by getPublicBusinessBySlug.
        // Browser reads stay scoped to authenticated operators.
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId) || isBusinessStaff(barberId);
        // Escritura solo para admin de la barbería o super admin
        allow write: if isSuperAdmin() || isOperationalBusinessAdmin(barberId);
      }

      match /barbers/{staffId} {
        // Public booking professionals are allowlisted by
        // getPublicBusinessBySlug. Preserve existing private role access.
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId) || isAssignedStaff(barberId, staffId) ||
          hasOwnStaffProfileBinding(barberId, staffId);
        allow create: if (businessIsActive(barberId) && validDirectEnrollmentStaffCreate(barberId, staffId)) ||
          (businessIsActive(barberId) && validStoreadminOwnProfileCreate(barberId, staffId));
        allow delete: if false;
        allow update: if isSuperAdmin() || businessAdminCanUpdateStaffSchedule(barberId) ||
          (businessIsActive(barberId) && (ownProfessionalProfileCanUpdate(barberId, staffId) ||
            staffAdminCanUpdateStaffRecord(barberId, staffId) ||
            validRetiredProfessionalPhotoCleanup(barberId) || staffCanUpdateOwnSchedule(barberId, staffId)));
      }

      match /staffControl/enrollment {
        // The current code is visible only to the business administrator who can rotate it.
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId);
        allow write: if isSuperAdmin() || isOperationalBusinessAdmin(barberId);
      }

       match /appointments/{appointmentId} {
        // Appointments contain PII and are never publicly readable. A public
        // client may only create the strict pending shape linked to a lock.
         allow create: if isSuperAdmin() || isOperationalBusinessAdmin(barberId);
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId) ||
          (isOperationalBusinessStaff(barberId) &&
            ((resource.data.keys().hasAll(['assignmentState']) && resource.data.assignmentState == 'unassigned') ||
              (resource.data.keys().hasAll(['barberId']) && isAssignedStaff(barberId, resource.data.barberId))));
        allow update: if isSuperAdmin() || (isOperationalBusinessAdmin(barberId) && bookingPrivacyConsentUnchanged()) ||
          (isOperationalBusinessStaff(barberId) && (staffCanUpdateAssignedAppointment(barberId) || staffCanClaimUnassignedAppointment(barberId)));
        allow delete: if isSuperAdmin() || isOperationalBusinessAdmin(barberId);
      }

       match /bookingLocks/{bookingDate}/staff/{staffId}/intervals/{intervalId} {
        // Locks contain no PII. Public availability reads only these small,
        // predictable documents; appointments remain private.
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId) || isBusinessStaff(barberId) || businessIsActive(barberId);
         allow create: if isSuperAdmin() || isOperationalBusinessAdmin(barberId) ||
           validClaimLockCreate(barberId, bookingDate, staffId, intervalId);
        allow update: if isSuperAdmin() || isOperationalBusinessAdmin(barberId);
        allow delete: if isSuperAdmin() || isOperationalBusinessAdmin(barberId) || validClaimLockDelete(barberId, bookingDate, staffId, intervalId);
      }

      match /catalog/{itemId} {
        // Lectura pública
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId) || businessIsActive(barberId);
        // Escritura solo para admin de la barbería o super admin
        allow create, update: if (isSuperAdmin() || isOperationalBusinessAdmin(barberId)) && validOptionalContentDescription();
        allow delete: if isSuperAdmin() || isOperationalBusinessAdmin(barberId);
      }

      match /products/{productId} {
        // Public product data is returned only by getPublicBusinessBySlug,
        // which validates the canonical business with server time and emits a
        // strict DTO. Browser Firestore reads remain internal.
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId) || isBusinessStaff(barberId);
        // Escritura solo para admin de la barbería o super admin
        allow create, update: if (isSuperAdmin() || isOperationalBusinessAdmin(barberId)) && validOptionalContentDescription();
        allow delete: if isSuperAdmin() || isOperationalBusinessAdmin(barberId);
      }
    }

    match /staffEnrollmentCodes/{code} {
      // `get` permits only an exact bearer-code lookup; discovery by query is denied.
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSuperAdmin() ||
        (request.resource.data.keys().hasOnly(['businessId', 'createdAt']) &&
          isOperationalBusinessAdmin(request.resource.data.businessId) &&
          getAfter(/databases/$(database)/documents/barbers/$(request.resource.data.businessId)/staffControl/enrollment).data.code == code);
      allow delete: if isSuperAdmin() ||
        (isOperationalBusinessAdmin(resource.data.businessId) &&
          getAfter(/databases/$(database)/documents/barbers/$(resource.data.businessId)/staffControl/enrollment).data.code != code);
      allow update: if false;
    }

    match /publicBusinesses/{barberId} {
      // Public presentation now goes through getPublicBusinessBySlug. Keep
      // this projection private to the business's authenticated operators.
      allow read: if isSuperAdmin() || isBusinessAdmin(barberId) || isBusinessStaff(barberId);
      allow create: if isSuperAdmin() && validPublicBusiness() && publicBusinessSlugMatchesRoot(barberId) &&
        publicOperationalStateMatchesRootAfter(barberId);
      allow delete: if isSuperAdmin() && getAfter(/databases/$(database)/documents/barbers/$(barberId)).data == null;
      // Business admins may synchronize public presentation and booking fields,
      // but cannot reactivate a business through the projection.
      allow update: if validPublicBusiness() && publicBusinessSlugUnchangedOrMatchesRootAfter(barberId) && publicOperationalStateUnchangedOrMatchesRootAfter(barberId) &&
        (isSuperAdmin() || (isOperationalBusinessAdmin(barberId) &&
          request.resource.data.active == resource.data.active && request.resource.data.slug == resource.data.slug));

    }

    // Denegar acceso por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Central role policy. Every rule below uses only these access predicates.
    function signedIn() { return request.auth != null; }
    function user() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return signedIn() ? user().data.role : null; }
    function isSuperadmin() { return role() == 'superadmin'; }
    function managesBusiness(businessId) {
      return isSuperadmin() || (role() == 'storeadmin' &&
        user().data.businessIds is list && user().data.businessIds.hasAny([businessId]));
    }
    function isStaffInBusiness(businessId) {
      return role() == 'staff' && user().data.staffId == request.auth.uid &&
        user().data.businessIds == [businessId];
    }
    function managesUser() {
      return isSuperadmin() || (role() == 'storeadmin' && resource.data.businessIds is list &&
        user().data.businessIds is list && resource.data.businessIds.hasAny(user().data.businessIds));
    }
    // A Customer may create only their own inactive staff profile while the same
    // transaction binds their account to a valid, unexpired enrollment-code document.
    function redeemsStaffEnrollment(businessId, staffId) {
      let nextUser = getAfter(/databases/$(database)/documents/users/$(request.auth.uid));
      let code = nextUser.data.enrollmentCode;
      return signedIn() && staffId == request.auth.uid && role() == 'customer' &&
        nextUser.data.role == 'staff' && nextUser.data.staffId == staffId &&
        nextUser.data.businessIds == [businessId] && code is string &&
        exists(/databases/$(database)/documents/staffEnrollmentCodes/$(code)) &&
        get(/databases/$(database)/documents/staffEnrollmentCodes/$(code)).data.businessId == businessId &&
        request.resource.data.accountUid == request.auth.uid &&
        request.resource.data.active == false && request.resource.data.accountStatus == 'inactive';
    }

    // Accounts: users manage their own profile; Superadmin and the matching
    // Storeadmin may manage accounts assigned to one of their businesses.
    match /users/{uid} {
      allow read: if signedIn() && (isSuperadmin() || request.auth.uid == uid || managesUser());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (isSuperadmin() || request.auth.uid == uid || managesUser());
      allow delete: if isSuperadmin();
    }

    // Root business plus every operational subcollection. Superadmin has all
    // access; Storeadmin has all access only to businesses in businessIds.
    match /barbers/{businessId} {
      allow read, write: if managesBusiness(businessId);

      match /{document=**} {
        allow read, write: if managesBusiness(businessId);
      }

      // Staff can access only their own profile, schedule and assigned agenda.
      match /barbers/{staffId} {
        allow create: if redeemsStaffEnrollment(businessId, staffId);
        allow read, update: if isStaffInBusiness(businessId) && staffId == request.auth.uid;
      }
      match /appointments/{appointmentId} {
        allow read: if (isStaffInBusiness(businessId) &&
          (resource.data.barberId == request.auth.uid ||
            resource.data.assignmentState == 'unassigned')) ||
          (signedIn() && resource.data.customerUid == request.auth.uid);
      }

      // Availability contains no customer data and is readable by the public agenda.
      match /bookingLocks/{bookingDate}/staff/{staffId}/intervals/{intervalId} {
        allow read: if true;
      }
    }

    // The public business projection is intentionally readable by everyone.
    match /publicBusinesses/{businessId} {
      allow read: if true;
      allow write: if managesBusiness(businessId);
    }

    // A signed-in customer can redeem a known enrollment code; discovery by
    // collection query remains disabled.
    match /staffEnrollmentCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if isSuperadmin() ||
        (role() == 'storeadmin' && request.resource.data.businessId is string && managesBusiness(request.resource.data.businessId));
    }

    // Public booking is handled by createPublicBooking; no anonymous Firestore
    // writes expose appointment or capacity records directly.
    match /{document=**} { allow read, write: if false; }
  }
}

        (rules.size() <= 42 || validPublicClosureRule(rules[42])) && (rules.size() <= 43 || validPublicClosureRule(rules[43])) &&
        (rules.size() <= 44 || validPublicClosureRule(rules[44])) && (rules.size() <= 45 || validPublicClosureRule(rules[45])) &&
        (rules.size() <= 46 || validPublicClosureRule(rules[46])) && (rules.size() <= 47 || validPublicClosureRule(rules[47])) &&

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserRole() {
      return isSignedIn() ? currentUserDoc().data.role : null;
    }

    function isSuperAdmin() {
      return isSignedIn() && currentUserRole() == 'superadmin';
    }

    function isStoreAdminRole() {
      return isSignedIn() && currentUserRole() == 'storeadmin';
    }

    function isStaffRole() {
      return isSignedIn() && currentUserRole() == 'staff';
    }

    function isBusinessAdmin(barberId) {
      return isStoreAdminRole() && hasBusinessMembership(barberId);
    }

    function hasBusinessMembership(barberId) {
      return currentUserDoc().data.keys().hasAll(['businessIds']) &&
        currentUserDoc().data.businessIds.hasAny([barberId]);
    }

    function isBusinessStaff(barberId) {
      return isStaffRole() &&
        currentUserDoc().data.keys().hasAll(['businessIds', 'staffId']) &&
        currentUserDoc().data.businessIds == [barberId] &&
        hasActiveStaffBinding(barberId, currentUserDoc().data.staffId);
    }

    function hasActiveStaffBinding(barberId, staffId) {
      let publicStaff = get(/databases/$(database)/documents/barbers/$(barberId)/barbers/$(staffId));
      return isSignedIn() && staffId == request.auth.uid && exists(/databases/$(database)/documents/barbers/$(barberId)/barbers/$(staffId)) &&
        (!publicStaff.data.keys().hasAll(['accountUid']) || publicStaff.data.accountUid == request.auth.uid) &&
        publicStaff.data.active == true && publicStaff.data.accountStatus == 'active';
    }

    // This identity proof permits inactive Staff to observe only their exact
    // public profile. It grants no operational access.
    function hasOwnStaffProfileBinding(barberId, staffId) {
      let publicStaff = get(/databases/$(database)/documents/barbers/$(barberId)/barbers/$(staffId));
      return isSignedIn() &&
        exists(/databases/$(database)/documents/barbers/$(barberId)/barbers/$(staffId)) &&
        currentUserDoc().data.role == 'staff' && currentUserDoc().data.businessIds == [barberId] &&
        currentUserDoc().data.staffId == staffId && staffId == request.auth.uid &&
        publicStaff.data.role == 'Staff' &&
        (!publicStaff.data.keys().hasAll(['accountUid']) || publicStaff.data.accountUid == request.auth.uid) &&
        publicStaff.data.accountStatus in ['active', 'inactive'] &&
        publicStaff.data.active == (publicStaff.data.accountStatus == 'active');
    }

    function hasOwnStoreadminProfileBinding(barberId, staffId) {
      let publicStaff = get(/databases/$(database)/documents/barbers/$(barberId)/barbers/$(staffId));
      return isBusinessAdmin(barberId) && exists(/databases/$(database)/documents/barbers/$(barberId)/barbers/$(staffId)) &&
        currentUserDoc().data.staffId == staffId && currentUserDoc().data.professionalBusinessId == barberId &&
        staffId == request.auth.uid && publicStaff.data.role == 'Staff';
    }

    function validBusinessOwnerAssignment(barberId) {
      let ownerBefore = get(/databases/$(database)/documents/users/$(request.resource.data.ownerId));
      let ownerAfter = getAfter(/databases/$(database)/documents/users/$(request.resource.data.ownerId));
      return request.resource.data.ownerId is string &&
        ownerBefore.data.role == 'customer' &&
        !ownerBefore.data.keys().hasAny(['staffId']) &&
        (!ownerBefore.data.keys().hasAny(['businessIds']) || ownerBefore.data.businessIds.size() == 0) &&
        ownerAfter.data.role == 'storeadmin' &&
        ownerAfter.data.keys().hasAll(['businessIds']) &&
        ownerAfter.data.businessIds == [barberId] &&
        !ownerAfter.data.keys().hasAny(['staffId']);
    }

    function ownerAssignmentUnchangedOrValid(barberId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']) ||
        validBusinessOwnerAssignment(barberId);
    }

    function isAssignedStaff(barberId, staffId) {
      return isBusinessStaff(barberId) &&
        currentUserDoc().data.staffId == staffId &&
        hasActiveStaffBinding(barberId, staffId);
    }

    function staffCanUpdateOwnSchedule(barberId, staffId) {
      return (isAssignedStaff(barberId, staffId) || hasOwnStoreadminProfileBinding(barberId, staffId)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schedule', 'updatedAt']) &&
        validStaffSchedule(request.resource.data.schedule);
    }

    // Break contents are validated by the application because Rules cannot
    // iterate a dynamic list, but the persisted schedule must retain its
    // complete seven-day shape and scalar types.
    function validStaffScheduleDay(day) {
      return day is map && day.keys().hasAll(['enabled', 'start', 'end', 'breaks']) &&
        day.keys().hasOnly(['enabled', 'start', 'end', 'breaks']) &&
        day.enabled is bool && day.start is string && day.end is string && day.breaks is list &&
        day.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        day.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && day.start < day.end;
    }

    function validStaffSchedule(schedule) {
      return schedule is map && schedule.keys().hasAll(['0', '1', '2', '3', '4', '5', '6']) &&
        schedule.keys().hasOnly(['0', '1', '2', '3', '4', '5', '6']) &&
        validStaffScheduleDay(schedule['0']) && validStaffScheduleDay(schedule['1']) &&
        validStaffScheduleDay(schedule['2']) && validStaffScheduleDay(schedule['3']) &&
        validStaffScheduleDay(schedule['4']) && validStaffScheduleDay(schedule['5']) &&
        validStaffScheduleDay(schedule['6']);
    }

    function staffCanUpdateAssignedAppointment(barberId) {
      return isAssignedStaff(barberId, resource.data.barberId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        request.resource.data.status in ['done', 'no_show', 'cancelled'];
    }

    // A Customer atomically becomes inactive Staff using an exact business code.
    function validDirectEnrollmentUser(currentUser, enrolledUser, uid, barberId, staff) {
      let codeRecord = get(/databases/$(database)/documents/staffEnrollmentCodes/$(enrolledUser.enrollmentCode));
      return isSignedIn() && request.auth.uid == uid && currentUser.role == 'customer' &&
        !currentUser.keys().hasAny(['staffId', 'enrollmentCode']) &&
        (!currentUser.keys().hasAny(['businessIds']) || currentUser.businessIds.size() == 0) &&
        enrolledUser.role == 'staff' && enrolledUser.staffId == uid && enrolledUser.businessIds == [barberId] &&
        enrolledUser.enrollmentCode is string && codeRecord.data.businessId == barberId &&
        enrolledUser.diff(currentUser).affectedKeys().hasOnly(['role', 'businessIds', 'staffId', 'enrollmentCode', 'updatedAt']) &&
        staff.name is string && staff.name.size() > 0 && staff.name.size() <= 120 && staff.role == 'Staff' && staff.accountUid == uid && staff.active == false && staff.accountStatus == 'inactive' &&
        staff.createdAt == request.time && staff.updatedAt == request.time && staff.keys().hasOnly(['name', 'role', 'accountUid', 'active', 'accountStatus', 'createdAt', 'updatedAt']);
    }

    function validEnrollmentStatusUpdate(barberId, staffId) {
      let enrolledUser = getAfter(/databases/$(database)/documents/users/$(staffId));
      return isBusinessAdmin(barberId) && request.resource.data.role == 'Staff' &&
        (!request.resource.data.keys().hasAll(['accountUid']) || request.resource.data.accountUid == staffId) && request.resource.data.accountStatus in ['active', 'inactive'] &&
        request.resource.data.active == (request.resource.data.accountStatus == 'active') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'accountStatus', 'updatedAt']) &&
        enrolledUser.data.role == 'staff' && enrolledUser.data.staffId == staffId && enrolledUser.data.businessIds == [barberId] &&
        (request.resource.data.accountStatus != 'active' || !enrolledUser.data.keys().hasAny(['enrollmentCode']));
    }

    function validDirectEnrollmentUserUpdate(uid) {
      let businessId = request.resource.data.businessIds[0];
      let staff = getAfter(/databases/$(database)/documents/barbers/$(businessId)/barbers/$(uid));
      return request.resource.data.keys().hasAll(['businessIds']) && request.resource.data.businessIds is list &&
        request.resource.data.businessIds.size() == 1 &&
        validDirectEnrollmentUser(resource.data, request.resource.data, uid, businessId, staff.data);
    }

    function validDirectEnrollmentStaffCreate(barberId, staffId) {
      let currentUser = get(/databases/$(database)/documents/users/$(staffId));
      let enrolledUser = getAfter(/databases/$(database)/documents/users/$(staffId));
      return isSignedIn() && staffId == request.auth.uid &&
        validDirectEnrollmentUser(currentUser.data, enrolledUser.data, staffId, barberId, request.resource.data);
    }

    function validEnrollmentProofRemoval(uid) {
      let businessId = resource.data.businessIds[0];
      let publicStaff = getAfter(/databases/$(database)/documents/barbers/$(businessId)/barbers/$(resource.data.staffId));
      return isSignedIn() && request.auth.uid != uid && resource.data.role == 'staff' && resource.data.staffId == uid &&
        resource.data.businessIds is list && resource.data.businessIds.size() == 1 && isBusinessAdmin(businessId) && resource.data.keys().hasAll(['enrollmentCode']) && !request.resource.data.keys().hasAny(['enrollmentCode']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrollmentCode', 'updatedAt']) &&
        publicStaff.data.active == true && publicStaff.data.accountStatus == 'active';
    }

    function validStoreadminOwnProfileLink(uid) {
      let profile = getAfter(/databases/$(database)/documents/barbers/$(request.resource.data.professionalBusinessId)/barbers/$(request.resource.data.staffId));
      return isSignedIn() && request.auth.uid == uid && resource.data.role == 'storeadmin' &&
        request.resource.data.role == 'storeadmin' && request.resource.data.businessIds == resource.data.businessIds && !resource.data.keys().hasAny(['staffId', 'professionalBusinessId']) &&
        request.resource.data.staffId is string && request.resource.data.professionalBusinessId is string &&
        hasBusinessMembership(request.resource.data.professionalBusinessId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['staffId', 'professionalBusinessId', 'updatedAt']) &&
        profile.data.name is string && profile.data.name.size() > 0 && profile.data.name.size() <= 120 &&
        profile.data.role == 'Staff' && profile.data.active is bool &&
        !profile.data.keys().hasAny(['accountStatus']);
    }

    function validStoreadminOwnProfileCreate(barberId, staffId) {
      let account = getAfter(/databases/$(database)/documents/users/$(request.auth.uid));
      return isBusinessAdmin(barberId) && staffId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['name', 'role', 'active', 'createdAt', 'updatedAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120 &&
        request.resource.data.role == 'Staff' &&
        request.resource.data.active is bool && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time &&
        account.data.role == 'storeadmin' && account.data.staffId == staffId &&
        account.data.professionalBusinessId == barberId &&
        account.data.keys().hasAll(['businessIds']) && account.data.businessIds.hasAny([barberId]);
    }

    function validOwnProfileImagePath(barberId, staffId, path) {
      return path is string && path.matches('^barbers/' + barberId + '/barbers/' + staffId + '/assets/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.(jpg|png|webp)$');
    }

    function ownProfessionalProfileCanUpdate(barberId, staffId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (hasOwnStaffProfileBinding(barberId, staffId) || hasOwnStoreadminProfileBinding(barberId, staffId)) &&
        changed.hasOnly(['name', 'photoUrl', 'imageStoragePath', 'pendingImageCleanupPaths', 'updatedAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120 &&
        (!request.resource.data.keys().hasAny(['photoUrl']) || (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 2048)) &&
        (!request.resource.data.keys().hasAny(['imageStoragePath']) || validOwnProfileImagePath(barberId, staffId, request.resource.data.imageStoragePath)) &&
        (!request.resource.data.keys().hasAny(['pendingImageCleanupPaths']) || request.resource.data.pendingImageCleanupPaths is list);
    }

    function validRetirementProfilePatch() {
      return request.resource.data.active == false && !request.resource.data.keys().hasAny(['accountUid', 'accountStatus']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'active', 'accountUid', 'accountStatus', 'pendingImageCleanupPaths', 'updatedAt'
        ]) &&
        request.resource.data.pendingImageCleanupPaths is list &&
        (!resource.data.keys().hasAll(['imageStoragePath']) ||
          request.resource.data.pendingImageCleanupPaths.hasAny([resource.data.imageStoragePath])) &&
        (!resource.data.keys().hasAll(['pendingImageCleanupPaths']) ||
          request.resource.data.pendingImageCleanupPaths.hasAll(resource.data.pendingImageCleanupPaths));
    }

    function validProfessionalRetirement(barberId, staffId) {
      return isBusinessAdmin(barberId) && validRetirementProfilePatch() &&
        (!resource.data.keys().hasAny(['accountUid', 'accountStatus']) ||
          validLinkedStaffRetirement(staffId) || validLinkedStoreadminRetirement(barberId));
    }

    // Retirement never deletes the professional document because its booking and
    // schedule references remain historical. Once retired, a business admin may
    // only remove the exact photo metadata after Storage cleanup succeeds.
    function validRetiredProfessionalPhotoCleanup(barberId) {
      return isBusinessAdmin(barberId) && resource.data.active == false &&
        request.resource.data.active == false &&
        !resource.data.keys().hasAny(['accountUid', 'accountStatus']) &&
        !request.resource.data.keys().hasAny(['accountUid', 'accountStatus']) &&
        (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingImageCleanupPaths', 'updatedAt']) &&
            request.resource.data.pendingImageCleanupPaths is list &&
            resource.data.pendingImageCleanupPaths is list &&
            request.resource.data.pendingImageCleanupPaths.hasOnly(resource.data.pendingImageCleanupPaths)) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'photoUrl', 'imageStoragePath', 'pendingImageCleanupPaths', 'updatedAt'
          ]) &&
            resource.data.pendingImageCleanupPaths is list && resource.data.pendingImageCleanupPaths.size() == 0 &&
            !request.resource.data.keys().hasAny(['photoUrl', 'imageStoragePath', 'pendingImageCleanupPaths']))
        );
    }

    function validLinkedStaffRetirement(staffId) {
      let account = getAfter(/databases/$(database)/documents/users/$(staffId));
      return resource.data.keys().hasAll(['accountStatus']) && account.data.role == 'customer' &&
        !account.data.keys().hasAny(['businessIds', 'staffId', 'professionalBusinessId', 'enrollmentCode']);
    }

    function validLinkedStoreadminRetirement(barberId) {
      let account = getAfter(/databases/$(database)/documents/users/$(resource.data.accountUid));
      return resource.data.keys().hasAll(['accountUid']) && !resource.data.keys().hasAny(['accountStatus']) &&
        account.data.role == 'storeadmin' && account.data.businessIds.hasAny([barberId]) &&
        !account.data.keys().hasAny(['staffId', 'professionalBusinessId']);
    }

    function validProfessionalRetirementUser(uid) {
      let businessId = resource.data.businessIds[0];
      let profile = getAfter(/databases/$(database)/documents/barbers/$(businessId)/barbers/$(resource.data.staffId));
      return isSignedIn() && request.auth.uid != uid && resource.data.role == 'staff' && resource.data.staffId == uid &&
        resource.data.businessIds is list && resource.data.businessIds.size() == 1 &&
        profile.data.active == false && !profile.data.keys().hasAny(['accountUid', 'accountStatus']) &&
        request.resource.data.role == 'customer' && !request.resource.data.keys().hasAny(['businessIds', 'staffId', 'professionalBusinessId', 'enrollmentCode']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'businessIds', 'staffId', 'professionalBusinessId', 'enrollmentCode', 'updatedAt']) &&
        isBusinessAdmin(businessId);
    }

    function validStoreadminProfessionalUnlink() {
      let profile = getAfter(/databases/$(database)/documents/barbers/$(resource.data.professionalBusinessId)/barbers/$(resource.data.staffId));
      return isSignedIn() && resource.data.role == 'storeadmin' && resource.data.staffId is string &&
        profile.data.active == false && !profile.data.keys().hasAny(['accountUid', 'accountStatus']) &&
        request.resource.data.role == 'storeadmin' && request.resource.data.businessIds == resource.data.businessIds && !request.resource.data.keys().hasAny(['staffId', 'professionalBusinessId']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['staffId', 'professionalBusinessId', 'updatedAt']) &&
        isBusinessAdmin(resource.data.professionalBusinessId);
    }

    function staffAdminCanUpdateStaffRecord(barberId, staffId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return validProfessionalRetirement(barberId, staffId) ||
        validEnrollmentStatusUpdate(barberId, staffId) ||
        (isBusinessAdmin(barberId) && !resource.data.keys().hasAny(['accountStatus']) &&
          request.resource.data.active is bool && changed.hasOnly(['active', 'updatedAt']));
    }

    // Schedule administration is available to the scoped Storeadmin even when
    // booking is paused. It is intentionally independent of the operational
    // subscription gate, but remains limited to the canonical schedule shape.
    function businessAdminCanUpdateStaffSchedule(barberId) {
      return isBusinessAdmin(barberId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schedule', 'updatedAt']) &&
        validStaffSchedule(request.resource.data.schedule);
    }

    function operationalBusinessData(business) {
      // Legacy records remain operable until their first subscription save.
      // Canonical records must be enabled and inside their effective range.
      return business.data.active == true &&
        (!business.data.keys().hasAll(['subscriptionStatus']) || business.data.subscriptionStatus in ['active', 'trial']) &&
        (!business.data.keys().hasAll(['subscriptionStatus']) ||
          !business.data.keys().hasAll(['subscriptionStartsAt']) ||
          (business.data.subscriptionStartsAt is timestamp && business.data.subscriptionStartsAt <= request.time)) &&
        (!business.data.keys().hasAll(['subscriptionStatus']) ||
           !business.data.keys().hasAll(['planExpiresAt']) ||
           (business.data.planExpiresAt is timestamp && business.data.planExpiresAt >= request.time));
    }

    function businessIsActive(barberId) {
      return operationalBusinessData(get(/databases/$(database)/documents/barbers/$(barberId)));
    }

    function hasCanonicalPublicCutoff(business) {
      return business.data.keys().hasAll(['subscriptionStatus', 'planExpiresAt']) &&
        business.data.subscriptionStatus in ['active', 'trial'] &&
        business.data.planExpiresAt is timestamp;
    }

    // Canonical operational writes and their public mirror must commit in one
    // atomic client transaction/batch. `getAfter` observes the resulting state,
    // so a root deactivation or subscription change cannot leave a readable
    // active public projection behind.
    function publicOperationalStateMatchesRootAfter(barberId) {
      let root = getAfter(/databases/$(database)/documents/barbers/$(barberId));
      let publicBusiness = getAfter(/databases/$(database)/documents/publicBusinesses/$(barberId));
      return publicBusiness.data != null &&
        publicBusiness.data.active == operationalBusinessData(root) &&
        (operationalBusinessData(root) && hasCanonicalPublicCutoff(root)
          ? publicBusiness.data.keys().hasAll(['bookingEnabledUntil']) &&
            publicBusiness.data.bookingEnabledUntil == root.data.planExpiresAt
          : !publicBusiness.data.keys().hasAny(['bookingEnabledUntil']));
    }

    function operationalFieldsUnchangedOrPublicProjectionSynced(barberId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'active', 'subscriptionStatus', 'subscriptionStartsAt', 'planExpiresAt'
      ]) || publicOperationalStateMatchesRootAfter(barberId);
    }

    function publicProjectionRemovedAfterRootDelete(barberId) {
      return getAfter(/databases/$(database)/documents/publicBusinesses/$(barberId)).data == null;
    }

    function isOperationalBusinessAdmin(barberId) {
      return isBusinessAdmin(barberId) && businessIsActive(barberId);
    }

    function isOperationalBusinessStaff(barberId) {
      return isBusinessStaff(barberId) && businessIsActive(barberId);
    }

    // Business admins can operate their business, but cannot change ownership,
    // subscription, activation, limits, or any other protected top-level field.
    function businessAdminCanUpdateBusiness() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'businessType', 'config', 'workingHours', 'updatedAt'
      ]) && businessWorkingHoursUnchangedOrValid() && businessBookingSettingsUnchangedOrValid();
    }

    function validWorkingHoursDay(day) {
      return day is map && day.keys().hasAll(['open', 'close', 'enabled']) &&
        day.keys().hasOnly(['open', 'close', 'enabled']) &&
        day.open is string && day.close is string && day.enabled is bool &&
        day.open.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        day.close.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        day.open < day.close;
    }

    function validWorkingHours(hours) {
      return hours is map && hours.keys().hasAll(['0', '1', '2', '3', '4', '5', '6']) &&
        hours.keys().hasOnly(['0', '1', '2', '3', '4', '5', '6']) &&
        validWorkingHoursDay(hours['0']) && validWorkingHoursDay(hours['1']) &&
        validWorkingHoursDay(hours['2']) && validWorkingHoursDay(hours['3']) &&
        validWorkingHoursDay(hours['4']) && validWorkingHoursDay(hours['5']) &&
        validWorkingHoursDay(hours['6']);
    }

    function businessWorkingHoursUnchangedOrValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['workingHours']) ||
        validWorkingHours(request.resource.data.workingHours);
    }

    // Closure rules remain one embedded list. Firestore Rules cannot iterate a
    // dynamic list to validate every object, so the application validates each
    // rule before saving; Rules enforce only the enclosing booking shape and cap.
    function validBookingSettings(settings) {
      return settings is map && settings.keys().hasAll([
          'minimumNoticeMinutes', 'bookingHorizonDays', 'slotIntervalMinutes', 'exceptionalClosures', 'closureRules', 'customerFields', 'productSelectionEnabled'
        ]) && settings.keys().hasOnly([
          'minimumNoticeMinutes', 'bookingHorizonDays', 'slotIntervalMinutes', 'exceptionalClosures', 'closureRules', 'customerFields', 'productSelectionEnabled'
        ]) &&
        settings.minimumNoticeMinutes is int && settings.minimumNoticeMinutes >= 0 &&
        settings.bookingHorizonDays is int && settings.bookingHorizonDays >= 1 &&
        settings.slotIntervalMinutes is int && settings.slotIntervalMinutes >= 5 && settings.slotIntervalMinutes <= 120 &&
        settings.exceptionalClosures is list && settings.closureRules is list && settings.closureRules.size() <= 100 &&
        validBookingCustomerFields(settings.customerFields) && settings.productSelectionEnabled is bool;
    }

    function validBookingCustomerFields(fields) {
      return fields is map && fields.keys().hasAll(['email', 'address']) && fields.keys().hasOnly(['email', 'address']) &&
        fields.email in ['disabled', 'optional', 'required'] &&
        fields.address in ['disabled', 'optional', 'required'];
    }

    // Rules cannot iterate dynamic lists. Keep the per-rule schema small and
    // validate the bounded list in ten-item blocks so compilation stays safe.
    function validPublicClosureTimeRange(rule) {
      return !rule.keys().hasAny(['startTime', 'endTime']) ||
        (rule.keys().hasAll(['startTime', 'endTime']) && rule.startTime is string && rule.endTime is string &&
          rule.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && rule.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
          rule.startTime < rule.endTime);
    }

    function validPublicWeeklyClosureRule(rule) {
      return rule.kind == 'weekly' && rule.keys().hasAll(['weekday']) &&
        rule.keys().hasOnly(['id', 'kind', 'weekday', 'startTime', 'endTime']) &&
        rule.weekday is int && rule.weekday >= 0 && rule.weekday <= 6;
    }

    function validPublicDateClosureRule(rule) {
      return rule.kind == 'date' && rule.keys().hasAll(['date']) &&
        rule.keys().hasOnly(['id', 'kind', 'date', 'startTime', 'endTime']) &&
        rule.date is string && rule.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validPublicClosureRule(rule) {
      return rule is map && rule.keys().hasAll(['id', 'kind']) && rule.id is string &&
        rule.id.size() > 0 && rule.id.size() <= 120 && validPublicClosureTimeRange(rule) &&
        (validPublicWeeklyClosureRule(rule) || validPublicDateClosureRule(rule));
    }

    function validPublicClosureRules0(rules) {
      return (rules.size() <= 0 || validPublicClosureRule(rules[0])) && (rules.size() <= 1 || validPublicClosureRule(rules[1])) &&
        (rules.size() <= 2 || validPublicClosureRule(rules[2])) && (rules.size() <= 3 || validPublicClosureRule(rules[3])) &&
        (rules.size() <= 4 || validPublicClosureRule(rules[4])) && (rules.size() <= 5 || validPublicClosureRule(rules[5])) &&
        (rules.size() <= 6 || validPublicClosureRule(rules[6])) && (rules.size() <= 7 || validPublicClosureRule(rules[7])) &&
        (rules.size() <= 8 || validPublicClosureRule(rules[8])) && (rules.size() <= 9 || validPublicClosureRule(rules[9]));
    }

    function validPublicClosureRules10(rules) {
      return (rules.size() <= 10 || validPublicClosureRule(rules[10])) && (rules.size() <= 11 || validPublicClosureRule(rules[11])) &&
        (rules.size() <= 12 || validPublicClosureRule(rules[12])) && (rules.size() <= 13 || validPublicClosureRule(rules[13])) &&
        (rules.size() <= 14 || validPublicClosureRule(rules[14])) && (rules.size() <= 15 || validPublicClosureRule(rules[15])) &&
        (rules.size() <= 16 || validPublicClosureRule(rules[16])) && (rules.size() <= 17 || validPublicClosureRule(rules[17])) &&

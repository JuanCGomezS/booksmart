rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserRole() {
      return isSignedIn() ? currentUserDoc().data.role : null;
    }

    function isSuperAdmin() {
      return isSignedIn() && currentUserRole() == 'superadmin';
    }

    function isBarberOwner(barberId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/barbers/$(barberId)).data.ownerId == request.auth.uid;
    }

    function isBusinessAdmin(barberId) {
      return isBarberOwner(barberId) ||
        (isSignedIn() && currentUserRole() == 'barber_admin' && currentUserDoc().data.barberId == barberId);
    }

    function businessIsActive(barberId) {
      return get(/databases/$(database)/documents/barbers/$(barberId)).data.active == true;
    }

    // Business admins can operate their business, but cannot change ownership,
    // subscription, activation, limits, or any other protected top-level field.
    function businessAdminCanUpdateBusiness() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'businessType', 'config', 'workingHours', 'updatedAt'
      ]);
    }

    // Users collection
    match /users/{uid} {
      // Superadmin puede leer todo
      allow read: if isSuperAdmin() || (isSignedIn() && request.auth.uid == uid);

      // Registro inicial: cada usuario solo puede crearse como client
      allow create: if isSignedIn() && request.auth.uid == uid &&
                      request.resource.data.role == 'client';

      // Superadmin puede cambiar roles/barberId.
      // Usuario normal puede actualizar perfil, pero no role ni barberId.
      allow update: if isSuperAdmin() ||
                      (isSignedIn() && request.auth.uid == uid &&
                        !request.resource.data.diff(resource.data).changedKeys().hasAny(['role', 'barberId']));

      allow delete: if isSuperAdmin();
    }

    // Barbers collection - pública lectura, admin control total
    match /barbers/{barberId} {
      // Lectura pública de barbería activa
      allow read: if resource.data.active == true;
      
      // Super admin puede leer/escribir todo
      allow read, write: if isSuperAdmin();
      
      // Business admins may read their own business and update only operations fields.
      allow read: if isBusinessAdmin(barberId);
      allow update: if isBusinessAdmin(barberId) && businessAdminCanUpdateBusiness();
      
      // Subcolecciones
      match /services/{serviceId} {
        // Public queries must constrain active == true; legacy services are
        // migrated explicitly before these rules are deployed.
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId) ||
          (businessIsActive(barberId) && resource.data.active == true);
        // Escritura solo para admin de la barbería o super admin
        allow write: if isSuperAdmin() || isBusinessAdmin(barberId);
      }

      match /barbers/{staffId} {
        // Lectura pública de barberos disponibles
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId) ||
          (businessIsActive(barberId) && resource.data.active == true);
        // Escritura solo para admin de la barbería o super admin
        allow write: if isSuperAdmin() || isBusinessAdmin(barberId);
      }

      match /appointments/{appointmentId} {
        // Lectura solo para admin y super admin
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId);

        // Public booking is deferred until an authenticated server-side service
        // can validate availability and atomically create appointments.
        allow create: if false;
        
        // Lectura/escritura para admin y super admin
        allow write: if isSuperAdmin() || isBusinessAdmin(barberId);
      }

      match /catalog/{itemId} {
        // Lectura pública
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId) || businessIsActive(barberId);
        // Escritura solo para admin de la barbería o super admin
        allow write: if isSuperAdmin() || isBusinessAdmin(barberId);
      }

      match /products/{productId} {
        // Lectura pública de productos activos
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId) ||
          (businessIsActive(barberId) && resource.data.active == true);
        // Escritura solo para admin de la barbería o super admin
        allow write: if isSuperAdmin() || isBusinessAdmin(barberId);
      }
    }

    // Denegar acceso por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

        (rules.size() <= 52 || validPublicClosureRule(rules[52])) && (rules.size() <= 53 || validPublicClosureRule(rules[53])) &&
        (rules.size() <= 54 || validPublicClosureRule(rules[54])) && (rules.size() <= 55 || validPublicClosureRule(rules[55])) &&
        (rules.size() <= 56 || validPublicClosureRule(rules[56])) && (rules.size() <= 57 || validPublicClosureRule(rules[57])) &&
        (rules.size() <= 58 || validPublicClosureRule(rules[58])) && (rules.size() <= 59 || validPublicClosureRule(rules[59]));

    function validPublicClosureRules60(rules) {
      return (rules.size() <= 60 || validPublicClosureRule(rules[60])) && (rules.size() <= 61 || validPublicClosureRule(rules[61])) &&
        (rules.size() <= 62 || validPublicClosureRule(rules[62])) && (rules.size() <= 63 || validPublicClosureRule(rules[63])) &&
        (rules.size() <= 64 || validPublicClosureRule(rules[64])) && (rules.size() <= 65 || validPublicClosureRule(rules[65])) &&
        (rules.size() <= 66 || validPublicClosureRule(rules[66])) && (rules.size() <= 67 || validPublicClosureRule(rules[67])) &&

        (rules.size() <= 34 || validPublicClosureRule(rules[34])) && (rules.size() <= 35 || validPublicClosureRule(rules[35])) &&
        (rules.size() <= 36 || validPublicClosureRule(rules[36])) && (rules.size() <= 37 || validPublicClosureRule(rules[37])) &&
        (rules.size() <= 38 || validPublicClosureRule(rules[38])) && (rules.size() <= 39 || validPublicClosureRule(rules[39]));

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserRole() {
      return isSignedIn() ? currentUserDoc().data.role : null;
    }

    function isSuperAdmin() {
      return isSignedIn() && currentUserRole() == 'superadmin';
    }

    function isStoreAdminRole() {
      return isSignedIn() && currentUserRole() == 'storeadmin';
    }

    function isStaffRole() {
      return isSignedIn() && currentUserRole() == 'staff';
    }

    function isBusinessAdmin(barberId) {
      return isStoreAdminRole() && hasBusinessMembership(barberId);
    }

    function hasBusinessMembership(barberId) {
      return currentUserDoc().data.barberId == barberId ||
        (currentUserDoc().data.keys().hasAll(['businessIds']) &&
          currentUserDoc().data.businessIds.hasAny([barberId]));
    }

    function isBusinessStaff(barberId) {
      return isStaffRole() &&
        currentUserDoc().data.barberId == barberId &&
        currentUserDoc().data.keys().hasAll(['businessIds', 'staffId']) &&
        currentUserDoc().data.businessIds == [barberId] &&
        hasActiveStaffBinding(barberId, currentUserDoc().data.staffId);
    }

    function hasActiveStaffBinding(barberId, staffId) {
      let publicStaff = get(/databases/$(database)/documents/barbers/$(barberId)/barbers/$(staffId));
      return isSignedIn() && staffId == request.auth.uid && exists(/databases/$(database)/documents/barbers/$(barberId)/barbers/$(staffId)) &&
        (!publicStaff.data.keys().hasAll(['accountUid']) || publicStaff.data.accountUid == request.auth.uid) &&
        publicStaff.data.active == true && publicStaff.data.accountStatus == 'active';
    }

    // This identity proof permits inactive Staff to observe only their exact
    // public profile. It grants no operational access.
    function hasOwnStaffProfileBinding(barberId, staffId) {
      let publicStaff = get(/databases/$(database)/documents/barbers/$(barberId)/barbers/$(staffId));
      return isSignedIn() &&
        exists(/databases/$(database)/documents/barbers/$(barberId)/barbers/$(staffId)) &&
        currentUserDoc().data.role == 'staff' && currentUserDoc().data.barberId == barberId &&
        currentUserDoc().data.staffId == staffId && staffId == request.auth.uid &&
        publicStaff.data.role == 'Staff' &&
        (!publicStaff.data.keys().hasAll(['accountUid']) || publicStaff.data.accountUid == request.auth.uid) &&
        publicStaff.data.accountStatus in ['active', 'inactive'] &&
        publicStaff.data.active == (publicStaff.data.accountStatus == 'active');
    }

    function hasOwnStoreadminProfileBinding(barberId, staffId) {
      let publicStaff = get(/databases/$(database)/documents/barbers/$(barberId)/barbers/$(staffId));
      return isBusinessAdmin(barberId) && exists(/databases/$(database)/documents/barbers/$(barberId)/barbers/$(staffId)) &&
        currentUserDoc().data.staffId == staffId && currentUserDoc().data.professionalBusinessId == barberId &&
        publicStaff.data.accountUid == request.auth.uid;
    }

    function validBusinessOwnerAssignment(barberId) {
      let ownerBefore = get(/databases/$(database)/documents/users/$(request.resource.data.ownerId));
      let ownerAfter = getAfter(/databases/$(database)/documents/users/$(request.resource.data.ownerId));
      return request.resource.data.ownerId is string &&
        ownerBefore.data.role == 'customer' &&
        !ownerBefore.data.keys().hasAny(['barberId', 'staffId']) &&
        (!ownerBefore.data.keys().hasAny(['businessIds']) || ownerBefore.data.businessIds.size() == 0) &&
        ownerAfter.data.role == 'storeadmin' &&
        ownerAfter.data.barberId == barberId &&
        ownerAfter.data.keys().hasAll(['businessIds']) &&
        ownerAfter.data.businessIds == [barberId] &&
        !ownerAfter.data.keys().hasAny(['staffId']);
    }

    function ownerAssignmentUnchangedOrValid(barberId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']) ||
        validBusinessOwnerAssignment(barberId);
    }

    function isAssignedStaff(barberId, staffId) {
      return isBusinessStaff(barberId) &&
        currentUserDoc().data.staffId == staffId &&
        hasActiveStaffBinding(barberId, staffId);
    }

    function staffCanUpdateOwnSchedule(barberId, staffId) {
      return (isAssignedStaff(barberId, staffId) || hasOwnStoreadminProfileBinding(barberId, staffId)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schedule', 'updatedAt']);
    }

    function staffCanUpdateAssignedAppointment(barberId) {
      return isAssignedStaff(barberId, resource.data.barberId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        request.resource.data.status in ['done', 'no_show', 'cancelled'];
    }

    // A Customer atomically becomes inactive Staff using an exact business code.
    function validDirectEnrollmentUser(currentUser, enrolledUser, uid, barberId, staff) {
      let codeRecord = get(/databases/$(database)/documents/staffEnrollmentCodes/$(enrolledUser.enrollmentCode));
      return isSignedIn() && request.auth.uid == uid && currentUser.role == 'customer' &&
        !currentUser.keys().hasAny(['barberId', 'staffId', 'enrollmentCode']) &&
        (!currentUser.keys().hasAny(['businessIds']) || currentUser.businessIds.size() == 0) &&
        enrolledUser.role == 'staff' && enrolledUser.barberId == barberId && enrolledUser.staffId == uid && enrolledUser.businessIds == [barberId] &&
        enrolledUser.enrollmentCode is string && codeRecord.data.businessId == barberId &&
        enrolledUser.diff(currentUser).affectedKeys().hasOnly(['role', 'barberId', 'businessIds', 'staffId', 'enrollmentCode', 'updatedAt']) &&
        staff.name is string && staff.name.size() > 0 && staff.name.size() <= 120 && staff.role == 'Staff' && staff.accountUid == uid && staff.active == false && staff.accountStatus == 'inactive' &&
        staff.createdAt == request.time && staff.updatedAt == request.time && staff.keys().hasOnly(['name', 'role', 'accountUid', 'active', 'accountStatus', 'createdAt', 'updatedAt']);
    }

    function validEnrollmentStatusUpdate(barberId, staffId) {
      let enrolledUser = getAfter(/databases/$(database)/documents/users/$(staffId));
      return isBusinessAdmin(barberId) && request.resource.data.role == 'Staff' &&
        (!request.resource.data.keys().hasAll(['accountUid']) || request.resource.data.accountUid == staffId) && request.resource.data.accountStatus in ['active', 'inactive'] &&
        request.resource.data.active == (request.resource.data.accountStatus == 'active') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'accountStatus', 'updatedAt']) &&
        enrolledUser.data.role == 'staff' && enrolledUser.data.barberId == barberId && enrolledUser.data.staffId == staffId && enrolledUser.data.businessIds == [barberId] &&
        (request.resource.data.accountStatus != 'active' || !enrolledUser.data.keys().hasAny(['enrollmentCode']));
    }

    function validDirectEnrollmentUserUpdate(uid) {
      let staff = getAfter(/databases/$(database)/documents/barbers/$(request.resource.data.barberId)/barbers/$(uid));
      return validDirectEnrollmentUser(resource.data, request.resource.data, uid, request.resource.data.barberId, staff.data);
    }

    function validDirectEnrollmentStaffCreate(barberId, staffId) {
      let currentUser = get(/databases/$(database)/documents/users/$(staffId));
      let enrolledUser = getAfter(/databases/$(database)/documents/users/$(staffId));
      return isSignedIn() && staffId == request.auth.uid &&
        validDirectEnrollmentUser(currentUser.data, enrolledUser.data, staffId, barberId, request.resource.data);
    }

    function validEnrollmentProofRemoval(uid) {
      let publicStaff = getAfter(/databases/$(database)/documents/barbers/$(resource.data.barberId)/barbers/$(resource.data.staffId));
      return isSignedIn() && request.auth.uid != uid && resource.data.role == 'staff' && resource.data.staffId == uid &&
        isBusinessAdmin(resource.data.barberId) && resource.data.keys().hasAll(['enrollmentCode']) && !request.resource.data.keys().hasAny(['enrollmentCode']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrollmentCode', 'updatedAt']) &&
        publicStaff.data.active == true && publicStaff.data.accountStatus == 'active';
    }

    function validStoreadminSelfProfileLink(uid) {
      let profile = getAfter(/databases/$(database)/documents/barbers/$(request.resource.data.professionalBusinessId)/barbers/$(request.resource.data.staffId));
      return isSignedIn() && request.auth.uid == uid && resource.data.role == 'storeadmin' &&
        request.resource.data.role == 'storeadmin' && request.resource.data.barberId == resource.data.barberId &&
        request.resource.data.businessIds == resource.data.businessIds && !resource.data.keys().hasAny(['staffId', 'professionalBusinessId']) &&
        request.resource.data.staffId is string && request.resource.data.professionalBusinessId is string &&
        request.resource.data.businessIds.hasAny([request.resource.data.professionalBusinessId]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['staffId', 'professionalBusinessId', 'updatedAt']) &&
        profile.data.active == true && profile.data.accountUid == uid &&
        !profile.data.keys().hasAny(['accountStatus']);
    }

    function validStoreadminSelfProfileLinkProfile(barberId, staffId) {
      let account = getAfter(/databases/$(database)/documents/users/$(request.auth.uid));
      return isBusinessAdmin(barberId) && resource.data.active == true &&
        !resource.data.keys().hasAny(['accountUid', 'accountStatus', 'userId']) &&
        request.resource.data.accountUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountUid', 'updatedAt']) &&
        account.data.role == 'storeadmin' && account.data.staffId == staffId &&
        account.data.professionalBusinessId == barberId && account.data.businessIds.hasAny([barberId]);
    }

    function validRetirementProfilePatch() {
      return request.resource.data.active == false && !request.resource.data.keys().hasAny(['accountUid', 'accountStatus']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'accountUid', 'accountStatus', 'updatedAt']);
    }

    function validProfessionalRetirement(barberId, staffId) {
      return isBusinessAdmin(barberId) && validRetirementProfilePatch() &&
        (!resource.data.keys().hasAny(['accountUid', 'accountStatus']) ||
          validLinkedStaffRetirement(staffId) || validLinkedStoreadminRetirement(barberId));
    }

    function validLinkedStaffRetirement(staffId) {
      let account = getAfter(/databases/$(database)/documents/users/$(staffId));
      return resource.data.keys().hasAll(['accountStatus']) && account.data.role == 'customer' &&
        !account.data.keys().hasAny(['barberId', 'businessIds', 'staffId', 'professionalBusinessId', 'enrollmentCode']);
    }

    function validLinkedStoreadminRetirement(barberId) {
      let account = getAfter(/databases/$(database)/documents/users/$(resource.data.accountUid));
      return resource.data.keys().hasAll(['accountUid']) && !resource.data.keys().hasAny(['accountStatus']) &&
        account.data.role == 'storeadmin' && account.data.barberId == barberId && account.data.businessIds.hasAny([barberId]) &&
        !account.data.keys().hasAny(['staffId', 'professionalBusinessId']);
    }

    function validProfessionalRetirementUser(uid) {
      let profile = getAfter(/databases/$(database)/documents/barbers/$(resource.data.barberId)/barbers/$(resource.data.staffId));
      return isSignedIn() && request.auth.uid != uid && resource.data.role == 'staff' && resource.data.staffId == uid &&
        profile.data.active == false && !profile.data.keys().hasAny(['accountUid', 'accountStatus']) &&
        request.resource.data.role == 'customer' && !request.resource.data.keys().hasAny(['barberId', 'businessIds', 'staffId', 'professionalBusinessId', 'enrollmentCode']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'barberId', 'businessIds', 'staffId', 'professionalBusinessId', 'enrollmentCode', 'updatedAt']) &&
        isBusinessAdmin(resource.data.barberId);
    }

    function validStoreadminProfessionalUnlink(uid) {
      let profile = getAfter(/databases/$(database)/documents/barbers/$(resource.data.professionalBusinessId)/barbers/$(resource.data.staffId));
      return isSignedIn() && resource.data.role == 'storeadmin' && resource.data.staffId is string &&
        profile.data.active == false && !profile.data.keys().hasAny(['accountUid', 'accountStatus']) &&
        request.resource.data.role == 'storeadmin' && request.resource.data.barberId == resource.data.barberId &&
        request.resource.data.businessIds == resource.data.businessIds && !request.resource.data.keys().hasAny(['staffId', 'professionalBusinessId']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['staffId', 'professionalBusinessId', 'updatedAt']) &&
        isBusinessAdmin(resource.data.professionalBusinessId);
    }

    function staffAdminCanUpdateStaffRecord(barberId, staffId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return validProfessionalRetirement(barberId, staffId) ||
        (isBusinessAdmin(barberId) && !changed.hasAny(['accountUid']) &&
          (!resource.data.keys().hasAny(['accountStatus']) ||
            (!changed.hasAny(['active', 'accountStatus']) && !request.resource.data.keys().hasAny(['accountUid'])) ||
            validEnrollmentStatusUpdate(barberId, staffId)));
    }

    function businessIsActive(barberId) {
      return get(/databases/$(database)/documents/barbers/$(barberId)).data.active == true;
    }

    // Business admins can operate their business, but cannot change ownership,
    // subscription, activation, limits, or any other protected top-level field.
    function businessAdminCanUpdateBusiness() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'businessType', 'config', 'workingHours', 'updatedAt'
      ]) && businessWorkingHoursUnchangedOrValid();
    }

    function validWorkingHoursDay(day) {
      return day is map && day.keys().hasAll(['open', 'close', 'enabled']) &&
        day.keys().hasOnly(['open', 'close', 'enabled']) &&
        day.open is string && day.close is string && day.enabled is bool &&
        day.open.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        day.close.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        day.open < day.close;
    }

    function validWorkingHours(hours) {
      return hours is map && hours.keys().hasAll(['0', '1', '2', '3', '4', '5', '6']) &&
        hours.keys().hasOnly(['0', '1', '2', '3', '4', '5', '6']) &&
        validWorkingHoursDay(hours['0']) && validWorkingHoursDay(hours['1']) &&
        validWorkingHoursDay(hours['2']) && validWorkingHoursDay(hours['3']) &&
        validWorkingHoursDay(hours['4']) && validWorkingHoursDay(hours['5']) &&
        validWorkingHoursDay(hours['6']);
    }

    function businessWorkingHoursUnchangedOrValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['workingHours']) ||
        validWorkingHours(request.resource.data.workingHours);
    }

    // This projection is the sole anonymous source for business presentation
    // and booking policy. Its allowlist deliberately excludes owner, billing,
    // trial, plan, limits, and every other internal field in `barbers/{id}`.
    function validGoogleMapsUrl(url) {
      return url is string && (
        url.matches('^https://www\\.google\\.com/maps/place/.+') ||
        url.matches('^https://maps\\.google\\.com/maps/place/.+')
      );
    }

    function validBusinessLocation(location) {
      return location is map && location.keys().hasAll(['latitude', 'longitude']) &&
        location.keys().hasOnly(['latitude', 'longitude']) &&
        location.latitude is number && location.longitude is number &&
        location.latitude >= -90 && location.latitude <= 90 &&
        location.longitude >= -180 && location.longitude <= 180;
    }

    function publicBusinessSlugMatchesRoot(barberId) {
      return request.resource.data.slug == getAfter(/databases/$(database)/documents/barbers/$(barberId)).data.slug;
    }

    function validBrandingAssetPath(barberId, slot, path) {
      return path is string && path.matches('^barbers/' + barberId + '/branding/' + slot + '/assets/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.(jpg|png|webp)$');
    }

    function validBrandingMetadata(barberId) {
      return request.resource.data.keys().hasOnly(['logoStoragePath', 'coverStoragePath', 'pendingImageCleanupPaths', 'updatedAt']) &&
        (!request.resource.data.keys().hasAny(['logoStoragePath']) || validBrandingAssetPath(barberId, 'logo', request.resource.data.logoStoragePath)) &&
        (!request.resource.data.keys().hasAny(['coverStoragePath']) || validBrandingAssetPath(barberId, 'cover', request.resource.data.coverStoragePath)) &&
        (!request.resource.data.keys().hasAny(['pendingImageCleanupPaths']) || request.resource.data.pendingImageCleanupPaths is list);
    }

    function validPublicBusiness() {
      return request.resource.data.keys().hasAll(['name', 'slug', 'businessType', 'active', 'config', 'workingHours']) &&
        request.resource.data.keys().hasOnly(['name', 'slug', 'businessType', 'active', 'config', 'workingHours']) &&
        request.resource.data.name is string && request.resource.data.slug is string &&
        request.resource.data.businessType is string && request.resource.data.active is bool &&
        request.resource.data.config is map && request.resource.data.config.keys().hasAll(['address', 'phone']) &&
        request.resource.data.config.keys().hasOnly(['address', 'phone', 'logoUrl', 'coverUrl', 'placeUrl', 'location', 'socialLinks', 'theme', 'booking']) &&
        (!request.resource.data.config.keys().hasAny(['placeUrl']) || validGoogleMapsUrl(request.resource.data.config.placeUrl)) &&
        (!request.resource.data.config.keys().hasAny(['location']) || validBusinessLocation(request.resource.data.config.location)) &&
        validWorkingHours(request.resource.data.workingHours);
    }

    // Browser bookings are deliberately an optimistic, client-only flow. Rules
    // validate record shape and the primary lock linkage, but cannot prove a
    // client supplied every interval lock or the complete scheduling policy.
    // This is not server-authoritative protection against malicious clients.
    function validPublicAppointment(barberId, appointmentId) {
      return request.resource.data.keys().hasAll([
          'clientName', 'clientPhone', 'barberId', 'serviceId', 'extraServices',
          'bookingDate', 'startTime', 'endTime', 'occupiedIntervalIds',
          'primaryLockId', 'status', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'clientName', 'clientPhone', 'barberId', 'serviceId', 'extraServices',
          'bookingDate', 'startTime', 'endTime', 'occupiedIntervalIds',
          'primaryLockId', 'status', 'notes', 'customerUid', 'createdAt'
        ]) &&
        request.resource.data.clientName is string && request.resource.data.clientName.size() > 0 && request.resource.data.clientName.size() <= 120 &&
        request.resource.data.clientPhone is string && request.resource.data.clientPhone.size() > 0 && request.resource.data.clientPhone.size() <= 40 &&
        (!request.resource.data.keys().hasAll(['notes']) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 500)) &&
        request.resource.data.barberId is string && request.resource.data.barberId.size() > 0 &&
        request.resource.data.serviceId is string && request.resource.data.serviceId.size() > 0 &&
        request.resource.data.extraServices is list && request.resource.data.extraServices.size() == 0 &&
        request.resource.data.bookingDate is string && request.resource.data.bookingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.startTime is string && request.resource.data.startTime.matches('^[0-2][0-9]:[0-5][0-9]$') &&
        request.resource.data.endTime is string && request.resource.data.endTime.matches('^[0-2][0-9]:[0-5][0-9]$') &&
        request.resource.data.occupiedIntervalIds is list && request.resource.data.occupiedIntervalIds.size() > 0 && request.resource.data.occupiedIntervalIds.size() <= 19 &&
        request.resource.data.primaryLockId is string && request.resource.data.occupiedIntervalIds.hasAny([request.resource.data.primaryLockId]) &&
        request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time &&
        (!request.resource.data.keys().hasAll(['customerUid']) ||
          (isSignedIn() && request.resource.data.customerUid is string && request.resource.data.customerUid == request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/barbers/$(barberId)/bookingLocks/$(request.resource.data.bookingDate)/staff/$(request.resource.data.barberId)/intervals/$(request.resource.data.primaryLockId)).data.appointmentId == appointmentId;
    }

    function validPublicBookingLock(barberId, bookingDate, staffId, intervalId) {
      let appointment = getAfter(/databases/$(database)/documents/barbers/$(barberId)/appointments/$(request.resource.data.appointmentId));
      return request.resource.data.keys().hasOnly(['appointmentId', 'bookingDate', 'staffId', 'intervalId', 'startTime', 'endTime', 'createdAt']) &&
        request.resource.data.keys().hasAll(['appointmentId', 'bookingDate', 'staffId', 'intervalId', 'startTime', 'endTime', 'createdAt']) &&
        request.resource.data.appointmentId is string && request.resource.data.appointmentId.size() > 0 &&
        request.resource.data.bookingDate == bookingDate && request.resource.data.staffId == staffId && request.resource.data.intervalId == intervalId &&
        request.resource.data.startTime is string && request.resource.data.startTime.matches('^[0-2][0-9]:[0-5][0-9]$') &&
        request.resource.data.endTime is string && request.resource.data.endTime.matches('^[0-2][0-9]:[0-5][0-9]$') &&
        request.resource.data.createdAt == request.time &&
        appointment.data.barberId == staffId && appointment.data.bookingDate == bookingDate &&
        appointment.data.occupiedIntervalIds.hasAny([intervalId]);
    }

    // Users collection
    match /users/{uid} {
      // Superadmin puede leer todo
      allow read: if isSuperAdmin() || (isSignedIn() && request.auth.uid == uid);

      // Registro inicial: cada usuario solo puede crearse como customer.
      allow create: if isSignedIn() && request.auth.uid == uid &&
                       request.resource.data.role == 'customer';

      // Superadmin puede cambiar roles y vínculos de negocio/personal.
      // Usuario normal puede actualizar perfil, pero no role ni vínculos.
      // A Superadmin may manage other accounts, but cannot alter their own
      // global role through a business-creation transaction or direct update.
      allow update: if (isSuperAdmin() &&
                          (request.auth.uid != uid ||
                            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))) ||
                            validDirectEnrollmentUserUpdate(uid) || validEnrollmentProofRemoval(uid) ||
                            validStoreadminSelfProfileLink(uid) || validProfessionalRetirementUser(uid) || validStoreadminProfessionalUnlink(uid) ||
                            (isSignedIn() && request.auth.uid == uid &&
                              !request.resource.data.diff(resource.data).changedKeys().hasAny(['role', 'barberId', 'businessIds', 'staffId', 'professionalBusinessId', 'enrollmentCode']));

      allow delete: if isSuperAdmin();
    }

    // Root businesses contain owner and billing data. They are never public.
    match /barbers/{barberId} {
      allow read, delete: if isSuperAdmin();
      // `ownerId` is descriptive metadata, never an authorization grant. A
      // created or reassigned owner must also be a Storeadmin member.
      allow create: if isSuperAdmin() && validBusinessOwnerAssignment(barberId) && validWorkingHours(request.resource.data.workingHours);
      
      // Root records include subscription and platform fields, so only platform
      // administrators can read them. Scoped clients may still update the
      // strictly allowlisted operational fields below.
      allow update: if (isSuperAdmin() && ownerAssignmentUnchangedOrValid(barberId) && businessWorkingHoursUnchangedOrValid()) ||
        (isBusinessAdmin(barberId) && businessAdminCanUpdateBusiness());
      
      // Subcolecciones
      match /services/{serviceId} {
        // Public queries must constrain active == true; legacy services are
        // migrated explicitly before these rules are deployed.
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId) || isBusinessStaff(barberId) ||
          (businessIsActive(barberId) && resource.data.active == true);
        // Escritura solo para admin de la barbería o super admin
        allow write: if isSuperAdmin() || isBusinessAdmin(barberId);
      }

      match /barbers/{staffId} {
        // Lectura pública de barberos disponibles
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId) || isAssignedStaff(barberId, staffId) ||
          hasOwnStaffProfileBinding(barberId, staffId) ||
          (businessIsActive(barberId) && resource.data.active == true);
        allow create: if validDirectEnrollmentStaffCreate(barberId, staffId) ||
          ((isSuperAdmin() || isBusinessAdmin(barberId)) && !request.resource.data.keys().hasAny(['accountUid', 'accountStatus']));
        allow delete: if false;
        allow update: if isSuperAdmin() || validStoreadminSelfProfileLinkProfile(barberId, staffId) ||
          staffAdminCanUpdateStaffRecord(barberId, staffId) || staffCanUpdateOwnSchedule(barberId, staffId);
      }

      match /staffControl/enrollment {
        // The current code is visible only to the business administrator who can rotate it.
        allow read, write: if isSuperAdmin() || isBusinessAdmin(barberId);
      }

      // Private replacement metadata lets Storeadmins clean up immutable branding
      // assets without ever exposing Storage paths through the public projection.
      match /brandingMetadata/assets {
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId);
        allow create, update: if (isSuperAdmin() || isBusinessAdmin(barberId)) && validBrandingMetadata(barberId);
        allow delete: if false;
      }

      match /appointments/{appointmentId} {
        // Appointments contain PII and are never publicly readable. A public
        // client may only create the strict pending shape linked to a lock.
        allow create: if isSuperAdmin() || isBusinessAdmin(barberId) ||
          (businessIsActive(barberId) && validPublicAppointment(barberId, appointmentId));
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId) || isAssignedStaff(barberId, resource.data.barberId);
        allow update: if isSuperAdmin() || isBusinessAdmin(barberId) || staffCanUpdateAssignedAppointment(barberId);
        allow delete: if isSuperAdmin() || isBusinessAdmin(barberId);
      }

      match /bookingLocks/{bookingDate}/staff/{staffId}/intervals/{intervalId} {
        // Locks contain no PII. Public availability reads only these small,
        // predictable documents; appointments remain private.
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId) || isBusinessStaff(barberId) || businessIsActive(barberId);
        allow create: if isSuperAdmin() || isBusinessAdmin(barberId) ||
          (businessIsActive(barberId) && validPublicBookingLock(barberId, bookingDate, staffId, intervalId));
        allow update, delete: if isSuperAdmin() || isBusinessAdmin(barberId);
      }

      match /catalog/{itemId} {
        // Lectura pública
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId) || businessIsActive(barberId);
        // Escritura solo para admin de la barbería o super admin
        allow write: if isSuperAdmin() || isBusinessAdmin(barberId);
      }

      match /products/{productId} {
        // Lectura pública de productos activos
        allow read: if isSuperAdmin() || isBusinessAdmin(barberId) || isBusinessStaff(barberId) ||
          (businessIsActive(barberId) && resource.data.active == true);
        // Escritura solo para admin de la barbería o super admin
        allow write: if isSuperAdmin() || isBusinessAdmin(barberId);
      }
    }

    match /staffEnrollmentCodes/{code} {
      // `get` permits only an exact bearer-code lookup; discovery by query is denied.
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSuperAdmin() ||
        (request.resource.data.keys().hasOnly(['businessId', 'createdAt']) &&
          isBusinessAdmin(request.resource.data.businessId) &&
          getAfter(/databases/$(database)/documents/barbers/$(request.resource.data.businessId)/staffControl/enrollment).data.code == code);
      allow delete: if isSuperAdmin() ||
        (isBusinessAdmin(resource.data.businessId) &&
          getAfter(/databases/$(database)/documents/barbers/$(resource.data.businessId)/staffControl/enrollment).data.code != code);
      allow update: if false;
    }

    match /publicBusinesses/{barberId} {
      // Public pages can only read active, allowlisted projections.
      // Public traffic still reads active projections only. Assigned internal
      // users may fetch an exact inactive summary for their own selector.
      allow read: if resource.data.active == true || isBusinessAdmin(barberId) || isBusinessStaff(barberId);
      allow create: if isSuperAdmin() && validPublicBusiness() && publicBusinessSlugMatchesRoot(barberId);
      allow delete: if isSuperAdmin();
      // Business admins may synchronize public presentation and booking fields,
      // but cannot reactivate a business through the projection.
      allow update: if validPublicBusiness() && publicBusinessSlugMatchesRoot(barberId) &&
        (isSuperAdmin() || (isBusinessAdmin(barberId) &&
          request.resource.data.active == resource.data.active && request.resource.data.slug == resource.data.slug));
    }

    // Denegar acceso por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

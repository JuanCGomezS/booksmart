---
import '../styles/global.css';
import FloatingNotifications from '../components/react/FloatingNotifications';

interface Props {
  title: string;
  description?: string;
  autonomous?: boolean;
}

const { title, description = 'BookSmart - Plataforma de agendamiento para negocios por cita', autonomous = false } = Astro.props;
const documentTitle = autonomous ? title : `${title} | BookSmart`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (() => {
        const redirectPath = sessionStorage.getItem('booksmart:redirect-path');
        if (redirectPath && redirectPath !== window.location.pathname + window.location.search + window.location.hash) {
          history.replaceState(null, '', redirectPath);
        }
        sessionStorage.removeItem('booksmart:redirect-path');

        const savedTheme = localStorage.getItem('booksmart-theme');
        const theme = savedTheme || 'gold-night';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <title>{documentTitle}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-screen bg-(--bg) text-(--text-primary) transition-colors duration-300">
    <slot />
    <FloatingNotifications client:load />
    
    <script is:inline>
      (() => {
        const buttons = document.querySelectorAll('.btn-primary');
        
        buttons.forEach((button) => {
          button.addEventListener('mousemove', (e) => {
            const rect = button.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            button.style.setProperty('--mouse-x', `${x}px`);
            button.style.setProperty('--mouse-y', `${y}px`);
          });
        });
      })();
    </script>
  </body>
</html>

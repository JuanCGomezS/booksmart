---
import AccountMenu from '../react/AccountMenu';

const baseUrl = import.meta.env.BASE_URL;
const loginPath = `${baseUrl}login`;
const homePath = `${baseUrl}#inicio`;
const featuresPath = `${baseUrl}#features`;
const contactPath = `${baseUrl}#contact`;
---

<header class="site-header sticky top-0 z-50 border-b backdrop-blur-xl" style="border-color: #b9bdc4; background: color-mix(in srgb, #101114 94%, transparent);">
  <div class="mx-auto flex h-15 w-full max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href={homePath} class="group inline-flex items-center gap-3">
      <img
        src={`${baseUrl}images/logo.png`}
        alt="Logo de BookSmart"
        class="h-10 w-10 shrink-0 object-contain"
        width="40"
        height="40"
        loading="eager"
        decoding="async"
      />
      <span class="text-2xl font-extrabold tracking-tight text-[#f1eee6]">BookSmart</span>
    </a>

    <AccountMenu
      client:load
      variant="site"
      loginTarget={loginPath}
      preserveLoginReturnPath={true}
      logoutTarget={baseUrl}
      guestNavigation={{
        homeHref: homePath,
        featuresHref: featuresPath,
        contactHref: contactPath,
      }}
    />
  </div>
</header>

---
const features = [
  {
    title: "Agendamiento",
    description:
      "Agendamiento por franja horaria, validación de disponibilidad y control de conflictos.",
    label: "Reserva",
    visual: "schedule",
  },
  {
    title: "Galería y portafolio",
    description:
      "Muestra resultados, instalaciones o trabajos para facilitar la decisión de tus clientes.",
    label: "Galería",
    visual: "gallery",
  },
  {
    title: "Productos",
    description:
      "Muestra tus productos con precio desde la misma operación.",
    label: "Productos",
    visual: "products",
  },
  {
    title: "Panel de control total",
    description:
      "Agenda diaria, estado de equipo y seguimiento de la operación en una sola mesa de trabajo.",
    label: "Operación",
    visual: "dashboard",
  },
  {
    title: "Personalización",
    description: "Adapta la plataforma a tu marca y estilo.",
    label: "Marca",
    visual: "customize",
  },
  {
    title: "Acceso",
    description:
      "Administradores y empleados ven sólo los controles que su trabajo necesita.",
    label: "Permisos",
    visual: "access",
  },
] as const;
---

<section id="features" class="landing-refinement features-section px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <header class="features-heading">
      <p class="press-kicker">Sistema de trabajo / no sólo una agenda</p>
      <h2>Todo lo que mueve tu negocio.</h2>
      <div class="features-heading-support">
        <p>
          Cada módulo tiene un trabajo concreto: convertir una visita pública en
          una operación clara para el negocio.
        </p>
        <p class="features-instruction">Explora cada módulo para ver cómo trabaja.</p>
      </div>
    </header>

    <ul class="features-grid" aria-label="Funciones de BookSmart">
      {
        features.map((feature) => (
          <li class:list={["feature-card", `feature-card--${feature.visual}`]}>
            <h3 id={`feature-${feature.visual}-title`} class="sr-only">{feature.title}</h3>
            <button
              class="feature-card-control"
              type="button"
              aria-label={`Mostrar detalle de ${feature.title}`}
              aria-pressed="false"
              data-card-title={feature.title}
            ></button>
            <div class="feature-card-inner">
              <div class="feature-card-face feature-card-front" data-card-face="front" aria-hidden="false">
                <div aria-hidden="true">
                  <span class="feature-card-meta">{feature.label}</span>
                  <span class:list={["feature-visual", `feature-visual--${feature.visual}`]} aria-hidden="true">
                    {feature.visual === "schedule" && (
                      <span class="visual-schedule">
                        <i></i><b>09:30</b><i></i><b>11:00</b><i></i><b>14:30</b>
                      </span>
                    )}
                    {feature.visual === "gallery" && (
                      <span class="visual-gallery"><i></i><i></i><i></i></span>
                    )}
                    {feature.visual === "products" && (
                      <span class="visual-products"><i></i><i></i><i></i></span>
                    )}
                    {feature.visual === "dashboard" && (
                      <span class="visual-dashboard"><i></i><i></i><i></i><i></i></span>
                    )}
                    {feature.visual === "customize" && (
                      <span class="visual-customize"><i></i><i></i><i></i><b></b></span>
                    )}
                    {feature.visual === "access" && (
                      <span class="visual-access"><i></i><i></i><i></i><b></b><b></b></span>
                    )}
                  </span>
                  <span class="feature-card-copy">
                    <strong>{feature.title}</strong>
                    <small>Ver detalle <span aria-hidden="true">↗</span></small>
                  </span>
                </div>
              </div>

              <div class="feature-card-face feature-card-back" data-card-face="back" aria-hidden="true" inert>
                <span class="feature-card-meta" aria-hidden="true">{feature.label} / en detalle</span>
                <strong aria-hidden="true">{feature.title}</strong>
                <p class="feature-card-description">{feature.description}</p>
                <span class="feature-card-return" aria-hidden="true">Volver <span aria-hidden="true">↺</span></span>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  const cards = document.querySelectorAll<HTMLButtonElement>(".feature-card-control");

  const canHover = window.matchMedia("(hover: hover)");

  const renderCardState = (card: HTMLButtonElement) => {
    const featureCard = card.closest(".feature-card");
    const isPinned = card.dataset.pinned === "true";
    const isHovered = card.dataset.hovered === "true";
    const isFlipped = card.dataset.dismissed !== "true" && (isPinned || isHovered);

    featureCard?.classList.toggle("is-flipped", isFlipped);
    card.setAttribute("aria-pressed", String(isPinned));
    card.setAttribute(
      "aria-label",
      `${isPinned ? "Ocultar" : isFlipped ? "Mantener visible" : "Mostrar"} detalle de ${card.dataset.cardTitle}`,
    );

    featureCard?.querySelectorAll<HTMLElement>("[data-card-face]").forEach((face) => {
      const isVisible = face.dataset.cardFace === (isFlipped ? "back" : "front");
      face.setAttribute("aria-hidden", String(!isVisible));
      face.toggleAttribute("inert", !isVisible);
    });
  };

  cards.forEach((card) => {
    card.addEventListener("click", () => {
      const shouldOpen = card.dataset.pinned !== "true";
      card.dataset.pinned = String(shouldOpen);
      card.dataset.dismissed = String(!shouldOpen);
      renderCardState(card);
    });

    card.addEventListener("pointerenter", () => {
      if (canHover.matches) {
        card.dataset.hovered = "true";
        card.dataset.dismissed = "false";
        renderCardState(card);
      }
    });

    card.addEventListener("pointerleave", () => {
      if (canHover.matches) {
        card.dataset.hovered = "false";
        renderCardState(card);
      }
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      cards.forEach((card) => {
        card.dataset.pinned = "false";
        card.dataset.dismissed = "true";
        renderCardState(card);
      });
    }
  });
</script>

<style>
  .features-section { color: var(--text-primary); }
  .features-heading { display: grid; gap: clamp(1.25rem, 2.5vw, 2rem); border-bottom: 1px solid color-mix(in srgb, var(--border) 74%, transparent); padding-bottom: clamp(2.75rem, 5vw, 4rem); text-align: center; }
  .features-heading .press-kicker { justify-self: start; margin: 0; text-align: left; }
  .features-heading h2 { width: 100%; margin: 0; font-size: clamp(3.1rem, 7vw, 5.75rem); font-weight: 750; letter-spacing: -.04em; line-height: .9; text-wrap: balance; }
  .features-heading-support { display: grid; justify-items: center; max-width: 42rem; gap: .75rem; justify-self: center; }
  .features-heading-support > p:first-child { max-width: 42rem; margin: 0; color: var(--text-secondary); font-size: 1rem; line-height: 1.65; }
  .features-instruction { margin: 0; color: var(--text-secondary); font-size: .78rem; font-weight: 700; letter-spacing: .02em; }
  .features-instruction::before { color: var(--secondary); content: '↻ '; }

  .features-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(.8rem, 2vw, 1.35rem); margin: 2rem 0 0; padding: 0; list-style: none; }
  .feature-card { position: relative; min-width: 0; min-height: 18rem; perspective: 1100px; }
  .feature-card-control { position: absolute; z-index: 1; inset: 0; width: 100%; border: 0; background: transparent; padding: 0; color: inherit; cursor: pointer; }
  .feature-card-inner { position: relative; display: block; min-height: inherit; transform-style: preserve-3d; transition: transform 620ms var(--motion); }
  .feature-card-face { position: absolute; inset: 0; display: flex; overflow: hidden; flex-direction: column; justify-content: space-between; border: 1px solid color-mix(in srgb, var(--border) 72%, transparent); border-radius: 1rem; backface-visibility: hidden; box-shadow: 7px 8px 18px color-mix(in srgb, var(--primary) 13%, transparent), 4px 4px 0 color-mix(in srgb, var(--primary) 32%, transparent); }
  .feature-card-front { background: var(--surface); padding: 1.25rem; }
  .feature-card-back { background: var(--press-surface); color: var(--press-fg); padding: 1.25rem; transform: rotateY(180deg); }
  .feature-card-meta { color: var(--accent-text); font-size: .7rem; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
  .feature-card-back .feature-card-meta { color: var(--press-accent); }
  .feature-card-copy { display: grid; gap: .5rem; }
  .feature-card-copy strong, .feature-card-back > strong { font-size: clamp(1.35rem, 2.4vw, 2rem); font-weight: 720; letter-spacing: -.04em; line-height: .98; text-wrap: balance; }
  .feature-card-copy small, .feature-card-return { color: var(--text-secondary); font-size: .78rem; font-weight: 750; }
  .feature-card-back .feature-card-description { max-width: 30ch; margin: 0; color: var(--press-fg-muted); font-size: .95rem; line-height: 1.55; }
  .feature-card-return { color: var(--press-accent); }

  .feature-visual { position: relative; display: block; height: 8.5rem; margin: 1rem 0; }
  .feature-visual::before { position: absolute; inset: 0; border: 1px solid color-mix(in srgb, var(--border) 55%, transparent); border-radius: .5rem; background: color-mix(in srgb, var(--surface-soft) 64%, var(--surface)); content: ''; }
  .visual-schedule, .visual-gallery, .visual-products, .visual-dashboard, .visual-customize, .visual-access { position: absolute; inset: .8rem; display: grid; }
  .visual-schedule { grid-template-columns: 1fr 2.2fr; grid-template-rows: repeat(3, 1fr); gap: .35rem .65rem; align-items: center; }
  .visual-schedule i { height: 100%; border-radius: 2px; background: var(--secondary); }
  .visual-schedule b { border-bottom: 1px solid var(--border); padding-bottom: .3rem; font-size: .75rem; letter-spacing: .04em; }
  .visual-gallery { grid-template-columns: 1fr .8fr 1.1fr; gap: .4rem; transform: rotate(-3deg); }
  .visual-gallery i { display: block; border: 1px solid var(--primary); background: var(--surface); box-shadow: 3px 3px 0 var(--accent); }
  .visual-gallery i:nth-child(2) { margin-top: 1rem; background: var(--secondary); box-shadow: 3px 3px 0 var(--primary); }
  .visual-gallery i:nth-child(3) { margin-bottom: .7rem; background: var(--accent); box-shadow: 3px 3px 0 var(--primary); }
  .visual-products { grid-template-columns: repeat(3, 1fr); align-items: end; gap: .7rem; }
  .visual-products i { display: block; border: 1px solid var(--primary); background: var(--surface); box-shadow: inset 0 -.65rem 0 var(--secondary); }
  .visual-products i:nth-child(1) { height: 56%; } .visual-products i:nth-child(2) { height: 88%; box-shadow: inset 0 -.65rem 0 var(--accent); } .visual-products i:nth-child(3) { height: 70%; }
  .visual-dashboard { grid-template-columns: 1fr; gap: .45rem; }
  .visual-dashboard i { display: block; border: 1px solid var(--border); background: var(--surface); }
  .visual-dashboard i:nth-child(1) { width: 78%; background: var(--primary); } .visual-dashboard i:nth-child(2) { width: 58%; background: var(--secondary); } .visual-dashboard i:nth-child(3) { width: 90%; background: var(--accent); } .visual-dashboard i:nth-child(4) { width: 66%; }
  .visual-customize { grid-template-columns: repeat(3, 1fr); gap: .5rem; }
  .visual-customize i { display: block; border: 1px solid var(--primary); } .visual-customize i:nth-child(1) { background: var(--primary); } .visual-customize i:nth-child(2) { background: var(--secondary); } .visual-customize i:nth-child(3) { background: var(--accent); }
  .visual-customize b { position: absolute; right: .8rem; bottom: .8rem; left: .8rem; height: 1.25rem; background: var(--surface); box-shadow: 3px 3px 0 var(--primary); }
  .visual-access { grid-template-columns: repeat(3, 1fr); align-items: center; gap: .55rem; }
  .visual-access i { display: block; aspect-ratio: 1; border: 1px solid var(--primary); border-radius: 50%; background: var(--surface); } .visual-access i:nth-child(1) { background: var(--secondary); } .visual-access i:nth-child(2) { background: var(--accent); }
  .visual-access b { position: absolute; top: 50%; right: 13%; left: 13%; height: 1px; background: var(--primary); transform: translateY(-50%); } .visual-access b:last-child { top: 65%; right: 28%; left: 28%; }

  .feature-card.is-flipped .feature-card-inner { transform: rotateY(180deg); }
  .feature-card:hover .feature-card-face, .feature-card:focus-within .feature-card-face { box-shadow: 10px 12px 22px color-mix(in srgb, var(--primary) 18%, transparent), 5px 5px 0 color-mix(in srgb, var(--primary) 34%, transparent); }
  .feature-card-control:focus-visible { outline: 3px solid var(--accent); outline-offset: 5px; border-radius: 1rem; }

  @media (min-width: 720px) {
    .features-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .feature-card { grid-column: span 4; }
    .feature-card--schedule, .feature-card--dashboard { grid-column: span 5; }
    .feature-card--gallery, .feature-card--customize { grid-column: span 3; }
    .feature-card--schedule, .feature-card--dashboard { min-height: 21rem; }
  }
  @media (max-width: 480px) { .features-grid { grid-template-columns: 1fr; } .feature-card { min-height: 17rem; } .features-heading { gap: 1.25rem; padding-bottom: 2.5rem; } .features-heading h2 { font-size: clamp(2.8rem, 13vw, 3.5rem); } }
  @media (prefers-reduced-motion: reduce) { .feature-card-inner { transition: none; } }
</style>

---
const features = [
  {
    title: 'Agendamiento',
    description: 'Reservas rápidas por franja horaria, con validación de disponibilidad y control de conflictos.',
    icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z',
  },
  {
    title: 'Galeria de cortes',
    description: 'Portafolio visual para mostrar estilos, atraer nuevos clientes y acelerar decisiones de compra.',
    icon: 'M4 16l4.6-4.6a2 2 0 0 1 2.8 0L16 16m-2-2l1.6-1.6a2 2 0 0 1 2.8 0L20 14m-6-6h.01M6 20h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z',
  },
  {
    title: 'Venta de productos',
    description: 'Catalogo de productos con stock y precio para impulsar ticket promedio desde la misma app.',
    icon: 'M16 11V7a4 4 0 0 0-8 0v4M5 9h14l1 12H4L5 9z',
  },
  {
    title: 'Panel de control total',
    description: 'Resumen claro de operaciones: agenda diaria, estado de equipo, metricas y seguimiento comercial.',
    icon: 'M12 6V4m0 2a2 2 0 1 0 0 4m0-4a2 2 0 1 1 0 4m-6 8a2 2 0 1 0 0-4m0 4a2 2 0 1 1 0-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 1 0 0-4m0 4a2 2 0 1 1 0-4m0 4v2m0-6V4',
  },
  {
    title: 'Escala a multiples locales',
    description: 'Gestiona varias sucursales con una sola cuenta, manteniendo equipos y reportes independientes.',
    icon: 'M17 20h5v-2a3 3 0 0 0-5.86-1.49M15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM6 20h12a6 6 0 0 0-6-6 6 6 0 0 0-6 6z',
  },
  {
    title: '100% gratuito para iniciar',
    description: 'Entrás sin tarjeta y validás resultados antes de pagar. Riesgo cero para adoptar el sistema.',
    icon: 'M12 8c-1.66 0-3 .9-3 2s1.34 2 3 2 3 .9 3 2-1.34 2-3 2m0-8c1.11 0 2.08.4 2.6 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.4-2.6-1M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z',
  },
];
---

<section id="features" class="section-shell px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-4xl font-bold text-main sm:text-5xl">Lo que ofrecemos</h2>
      <p class="mt-4 text-lg text-subtle">Un stack de producto completo para que tu operación diaria sea más rápida, ordenada y rentable.</p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <article class="surface-card rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:border-[var(--secondary)]">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl" style="background: color-mix(in srgb, var(--secondary) 24%, transparent);">
              <svg class="h-6 w-6" style="color: var(--secondary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={feature.icon} />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-main">{feature.title}</h3>
            <p class="mt-3 leading-relaxed text-subtle">{feature.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

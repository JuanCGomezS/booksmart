---
const features = [
  ['Agendamiento', 'Reservas por franja horaria, validación de disponibilidad y control de conflictos.', 'Publica'],
  ['Galería y portafolio', 'Muestra resultados, instalaciones o trabajos para facilitar la decisión de tus clientes.', 'Muestra'],
  ['Venta de productos', 'Catálogo de productos con stock y precio desde la misma operación.', 'Catálogo'],
  ['Panel de control total', 'Agenda diaria, estado de equipo y seguimiento de la operación en una sola mesa de trabajo.', 'Opera'],
  ['Escala a múltiples locales', 'Gestiona varias sucursales con una sola cuenta, con equipos y reportes independientes.', 'Conecta'],
  ['Acceso por rol', 'Superadmin, storeadmin y staff ven sólo los controles que su trabajo necesita.', 'Permite'],
] as const;
---

<section id="features" class="landing-refinement px-4 py-16 text-main sm:px-6 sm:py-24 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-6 border-b border-[var(--border)] pb-8 lg:grid-cols-[.7fr_1.3fr] lg:items-end">
      <p class="press-kicker">Sistema de trabajo / no sólo una agenda</p>
      <div><h2 class="max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl">Todo lo que mueve una cita, en registro.</h2><p class="mt-4 max-w-2xl text-base leading-relaxed text-subtle">Cada módulo tiene un trabajo concreto: convertir una visita pública en una operación clara para el negocio.</p></div>
    </div>
    <div class="mt-8 grid gap-x-10 md:grid-cols-2 lg:grid-cols-3">
      {features.map(([title, description, code]) => <article class="border-t border-[var(--border)] py-6 first:border-t-0 md:first:border-t lg:first:border-t-0">
        <p class="text-sm font-medium text-subtle">{code}</p>
        <h3 class="mt-3 max-w-xs text-xl font-semibold tracking-tight">{title}</h3>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-subtle">{description}</p>
      </article>)}
    </div>
  </div>
</section>

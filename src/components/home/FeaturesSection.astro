---
const features = [
  {
    title: 'Reservas seguras y administrables',
    description:
      'Recibe, confirma y organiza cada reserva con una agenda confiable para tu negocio y tus clientes.',
    label: 'Reservas',
    imageUrl: '/images/services/Reservas.jpg',
  },
  {
    title: 'Servicios bien organizados',
    description:
      'Clasifica tus servicios para que el cliente encuentre fácilmente lo que necesita y reserve con claridad.',
    label: 'Servicios',
    imageUrl: '/images/services/Servicios.jpg',
  },
  {
    title: 'Tu portafolio, a tu manera',
    description:
      'Comparte anuncios, trabajos y cualquier contenido que quieras mostrar para ayudar a tus clientes a decidir.',
    label: 'Portafolio',
    imageUrl: '/images/services/Portafolio.jpg',
  },
  {
    title: 'Productos a la vista',
    description:
      'Muestra tus productos a quienes ya confían en tu negocio y abre nuevas oportunidades de venta.',
    label: 'Productos',
    imageUrl: '/images/services/Productos.jpg',
  },
  {
    title: 'Toda tu operación en un solo lugar',
    description:
      'Agendas, catálogo, productos, personal, estadísticas e innovación reunidos para operar con más control.',
    label: 'Operación',
    imageUrl: '/images/services/Operación.jpg',
  },
  {
    title: 'Estadísticas que dan claridad',
    description:
      'Consulta lo que generan tus servicios y toma decisiones con información útil para el seguimiento contable.',
    label: 'Estadísticas',
    imageUrl: '/images/services/Estadisticas.jpg',
  },
  {
    title: 'Un diseño que se parece a ti',
    description:
      'Selecciona temas personalizados y ajusta la experiencia para que se vea alineada con el estilo de tu negocio.',
    label: 'Diseño',
    imageUrl: '/images/services/Diseño.jpg',
  },
  {
    title: 'IA para atender mejor',
    description:
      'Ofrece a tus clientes una forma ágil de consultar la información relevante de tu negocio.',
    label: 'IA',
    imageUrl: '/images/services/IA.jpg',
  },
] as const;

const carouselFeatures = [features[features.length - 1]!, ...features, features[0]!];
---

<section id="features" class="landing-refinement features-section px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
  <div class="features-board mx-auto max-w-6xl">
    <header class="features-heading">
      <h2>Tu negocio más completo<br /><em>y profesional.</em></h2>
      <p>
        Todo lo que necesitas para atender mejor, operar con claridad y hacer crecer tu negocio desde un solo lugar.
      </p>
    </header>

    <div class="capabilities-gallery" data-capabilities-gallery aria-roledescription="carrusel" aria-label="Capacidades de BookSmart">
      <div class="gallery-stage">
        <div class="gallery-reel" data-gallery-reel aria-live="off">
          {
            carouselFeatures.map((feature, index) => (
              <article
                class="capability-slide"
                role="group"
                aria-roledescription="diapositiva"
                aria-label={feature.title}
                data-gallery-slide
                aria-hidden={index === 1 ? 'false' : 'true'}
                inert={index === 1 ? undefined : true}
              >
                <div class="slide-image-frame">
                  {
                    feature.imageUrl ? (
                      <img src={feature.imageUrl} alt={feature.title} loading={index === 0 ? 'eager' : 'lazy'} />
                    ) : (
                      <div class="slide-image-placeholder" aria-hidden="true">
                        <span>IMAGEN</span>
                        <strong>PEGA TU URL AQUÍ</strong>
                      </div>
                    )
                  }
                </div>
                <div class="slide-copy">
                  <p class="slide-label">{feature.label}</p>
                  <h3>{feature.title}</h3>
                  <p class="slide-description">{feature.description}</p>
                </div>
              </article>
            ))
          }
        </div>
        <div class="gallery-overlay-controls" aria-label="Controles de la galería">
          <button type="button" class="gallery-arrow" data-gallery-prev aria-label="Ver capacidad anterior">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4 7 12l8 8" /></svg>
          </button>
          <button type="button" class="gallery-arrow" data-gallery-next aria-label="Ver siguiente capacidad">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 4 8 8-8 8" /></svg>
          </button>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const galleries = document.querySelectorAll<HTMLElement>('[data-capabilities-gallery]');

  galleries.forEach((gallery) => {
    const reel = gallery.querySelector<HTMLElement>('[data-gallery-reel]');
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-slide]'));
    const previous = gallery.querySelector<HTMLButtonElement>('[data-gallery-prev]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let currentIndex = 1;
    let timer: number | undefined;
    let loopReset: number | undefined;
    let paused = false;

    const render = (index: number, behavior: ScrollBehavior = 'smooth') => {
      currentIndex = (index + slides.length) % slides.length;
      const activeSlide = slides[currentIndex];
      if (reel && activeSlide) {
        const offset = activeSlide.offsetLeft - (reel.clientWidth - activeSlide.clientWidth) / 2;
        reel.scrollTo({ left: offset, behavior: reduceMotion.matches ? 'auto' : behavior });
      }
      slides.forEach((slide, slideIndex) => {
        const isCurrent = slideIndex === currentIndex;
        slide.setAttribute('aria-hidden', String(!isCurrent));
        slide.toggleAttribute('inert', !isCurrent);
      });
    };

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (paused || reduceMotion.matches) return;
      timer = window.setInterval(() => render(currentIndex + 1), 6500);
    };

    const move = (direction: number) => {
      const targetIndex = currentIndex + direction;
      render(targetIndex);
      if (loopReset !== undefined) window.clearTimeout(loopReset);
      if (targetIndex === 0 || targetIndex === slides.length - 1) {
        loopReset = window.setTimeout(() => {
          render(targetIndex === 0 ? slides.length - 2 : 1, 'auto');
        }, 680);
      }
      start();
    };

    previous?.addEventListener('click', () => move(-1));
    next?.addEventListener('click', () => move(1));
    gallery.addEventListener('mouseenter', () => { paused = true; stop(); });
    gallery.addEventListener('mouseleave', () => { paused = false; start(); });
    gallery.addEventListener('focusin', () => { paused = true; stop(); });
    gallery.addEventListener('focusout', () => {
      window.setTimeout(() => {
        if (!gallery.contains(document.activeElement)) {
          paused = false;
          start();
        }
      });
    });
    document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
    window.addEventListener('resize', () => render(currentIndex, 'auto'));
    reduceMotion.addEventListener('change', start);

    render(1, 'auto');
    start();
  });
</script>

<style>
  .features-section { color: var(--press-fg); }
  .features-board { position: relative; overflow: hidden; border: 1px solid var(--press-border); background-color: var(--press-surface); background-image: radial-gradient(var(--shell-dot) 1px, transparent 1px); background-size: 9px 9px; box-shadow: 12px 14px 0 var(--primary); padding: clamp(1.25rem, 4vw, 3.5rem); }
  .features-board::before, .features-board::after { position: absolute; width: clamp(5rem, 14vw, 10rem); height: clamp(5rem, 14vw, 10rem); border: 1px solid var(--press-accent); content: ''; pointer-events: none; }
  .features-board::before { top: -1px; right: -1px; border-width: 0 0 1px 1px; }
  .features-board::after { bottom: -1px; left: -1px; border-width: 1px 1px 0 0; }
  .features-heading, .capabilities-gallery { position: relative; z-index: 1; }
  .features-heading { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(15rem, .65fr); gap: 1rem clamp(2rem, 6vw, 6rem); align-items: end; padding: clamp(.5rem, 2vw, 1.25rem) 0 clamp(2.25rem, 5vw, 4rem); }
  .features-heading h2 { margin: 0; color: var(--press-fg); font-family: Oswald, sans-serif; font-size: clamp(3rem, 8vw, 6rem); font-weight: 700; letter-spacing: -.04em; line-height: .96; text-transform: uppercase; text-wrap: balance; }
  .features-heading h2 em { color: var(--secondary); font-style: normal; }
  .features-heading p { max-width: 30rem; margin: 0; color: var(--press-fg-muted); font-size: 1rem; line-height: 1.6; }

  .capabilities-gallery { border-top: 1px solid var(--shell-rule); padding-top: clamp(1.5rem, 3vw, 2.25rem); }
  .gallery-stage { position: relative; }
  .gallery-reel { display: flex; gap: clamp(.75rem, 2vw, 1.5rem); overflow-x: auto; overscroll-behavior-x: contain; padding: .75rem 14%; scroll-behavior: smooth; scrollbar-width: none; }
  .gallery-reel::-webkit-scrollbar { display: none; }
  .capability-slide { flex: 0 0 72%; min-width: 0; color: var(--press-fg); opacity: .42; transform: scale(.93); transition: opacity 450ms var(--motion), transform 650ms var(--motion); }
  .capability-slide[aria-hidden='false'] { opacity: 1; transform: scale(1); }
  .slide-image-frame { position: relative; aspect-ratio: 2.1; overflow: hidden; border: 1px solid var(--press-border); background: var(--press-paper-muted); box-shadow: 8px 10px 18px color-mix(in srgb, var(--primary) 35%, transparent); }
  .slide-image-frame img { width: 100%; height: 100%; object-fit: cover; }
  .slide-image-placeholder { display: grid; width: 100%; height: 100%; place-content: center; gap: .5rem; border: 1px dashed color-mix(in srgb, var(--press-border) 75%, transparent); background: linear-gradient(135deg, color-mix(in srgb, var(--secondary) 17%, var(--press-paper)), var(--press-paper-muted)); color: var(--text-primary); text-align: center; }
  .slide-image-placeholder span { color: var(--accent-text); font-size: .72rem; font-weight: 850; letter-spacing: .14em; }
  .slide-image-placeholder strong { font-family: Oswald, sans-serif; font-size: 1.25rem; font-weight: 700; letter-spacing: -.035em; line-height: .9; }
  .slide-copy { padding: .9rem .2rem 0; }
  .slide-label { margin: 0 0 .55rem; color: var(--press-accent); font-size: .72rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
  .slide-copy h3 { margin: 0; color: var(--press-fg); font-family: Oswald, sans-serif; font-size: 1.25rem; font-weight: 700; letter-spacing: -.035em; line-height: .92; text-transform: uppercase; text-wrap: balance; }
  .slide-description { max-width: 48ch; margin: .55rem 0 0; color: var(--press-fg-muted); font-size: 1rem; line-height: 1.45; }

  .gallery-overlay-controls { position: absolute; top: .75rem; left: 14%; z-index: 2; width: 72%; aspect-ratio: 2.1; pointer-events: none; }
  .gallery-arrow { position: absolute; top: 50%; display: grid; width: 2.5rem; height: 2.5rem; place-items: center; border: 0; background: transparent; color: var(--press-fg); cursor: pointer; pointer-events: auto; transform: translateY(-50%); transition: color 160ms ease, transform 160ms var(--motion); }
  .gallery-arrow:first-child { left: -3.1rem; }
  .gallery-arrow:last-child { right: -3.1rem; }
  .gallery-arrow:hover { color: var(--secondary); transform: translateY(-50%) scale(1.14); }
  .gallery-arrow:focus-visible { outline: 3px solid var(--press-accent); outline-offset: 4px; }
  .gallery-arrow svg { width: 1.35rem; fill: none; stroke: currentColor; stroke-linecap: square; stroke-width: 2; }
  @media (max-width: 720px) { .features-board { box-shadow: 7px 8px 0 var(--primary); padding: 1.15rem; } .features-heading { grid-template-columns: 1fr; padding-bottom: 2.25rem; } .gallery-reel { gap: .75rem; padding-inline: 9%; } .capability-slide { flex-basis: 82%; } .slide-image-frame { aspect-ratio: 1.8; } .gallery-overlay-controls { left: 9%; width: 82%; aspect-ratio: 1.8; } .gallery-arrow { width: 2rem; height: 2rem; } .gallery-arrow:first-child { left: -2.25rem; } .gallery-arrow:last-child { right: -2.25rem; } }
  @media (max-width: 420px) { .gallery-reel { padding-inline: 6%; } .capability-slide { flex-basis: 88%; } .gallery-overlay-controls { left: 6%; width: 88%; } .gallery-arrow { width: 1.75rem; height: 1.75rem; } .gallery-arrow:first-child { left: -1.85rem; } .gallery-arrow:last-child { right: -1.85rem; } }
  @media (prefers-reduced-motion: reduce) { .gallery-reel, .capability-slide, .gallery-arrow { scroll-behavior: auto; transition: none; } }
</style>

---
---

<section id="themes" class="landing-refinement section-shell px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <span class="badge-theme inline-flex rounded-full px-4 py-2 text-sm font-semibold">Feature premium</span>
        <h2 class="mt-5 text-4xl font-bold leading-tight text-main sm:text-5xl">
          Temas personalizados
          <span class="block text-(--secondary)">para cada identidad de negocio</span>
        </h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-subtle">
          Adaptá la identidad visual sin tocar código. Elegí una paleta y toda la experiencia se actualiza al instante: botones, tarjetas, tipografías y acentos.
        </p>

        <p class="my-3 max-w-xl text-lg leading-relaxed text-subtle">Temas oscuros</p>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Selector de tema">
          <button type="button" class="theme-btn rounded-xl px-4 py-2 text-sm font-semibold text-main" data-theme-value="gold-night" aria-pressed="false">Gold Night</button>
          <button type="button" class="theme-btn rounded-xl px-4 py-2 text-sm font-semibold text-main" data-theme-value="royal-night" aria-pressed="false">Royal Night</button>
          <button type="button" class="theme-btn rounded-xl px-4 py-2 text-sm font-semibold text-main" data-theme-value="crimson-sun" aria-pressed="false">Crimson Sun</button>
          <button type="button" class="theme-btn rounded-xl px-4 py-2 text-sm font-semibold text-main" data-theme-value="violet-blush" aria-pressed="false">Violet Blush</button>
        </div>
        
        <p class="my-3 max-w-xl text-lg leading-relaxed text-subtle">Temas claros</p>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Selector de tema">
          <button type="button" class="theme-btn rounded-xl px-4 py-2 text-sm font-semibold text-main" data-theme-value="teal-night" aria-pressed="false">Teal Night</button>
          <button type="button" class="theme-btn rounded-xl px-4 py-2 text-sm font-semibold text-main" data-theme-value="sunset-cream" aria-pressed="false">Sunset Cream</button>
          <button type="button" class="theme-btn rounded-xl px-4 py-2 text-sm font-semibold text-main" data-theme-value="orchid-rose" aria-pressed="false">Orchid Rose</button>
        </div>
      </div>

      <div class="surface-card rounded-3xl p-6 sm:p-8">
        <h3 class="text-lg font-semibold text-main">Vista previa del tema activo</h3>
        <p class="mt-2 text-sm text-subtle">El cambio queda guardado para mantener consistencia en sesiones futuras.</p>

        <div class="mt-6 grid grid-cols-2 gap-4">
          <div class="surface-soft rounded-2xl p-4">
            <p class="text-xs uppercase tracking-wide text-subtle">Primary</p>
            <div class="mt-2 h-8 rounded-lg" style="background: var(--primary);"></div>
          </div>
          <div class="surface-soft rounded-2xl p-4">
            <p class="text-xs uppercase tracking-wide text-subtle">Secondary</p>
            <div class="mt-2 h-8 rounded-lg" style="background: var(--secondary);"></div>
          </div>
          <div class="surface-soft rounded-2xl p-4">
            <p class="text-xs uppercase tracking-wide text-subtle">Accent</p>
            <div class="mt-2 h-8 rounded-lg" style="background: var(--accent);"></div>
          </div>
          <div class="surface-soft rounded-2xl p-4">
            <p class="text-xs uppercase tracking-wide text-subtle">Background</p>
            <div class="mt-2 h-8 rounded-lg border" style="background: var(--bg); border-color: var(--border);"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const KEY = 'booksmart-theme';
    const buttons = document.querySelectorAll('.theme-btn');

    const updateActive = (theme) => {
      buttons.forEach((btn) => {
        const isActive = btn.dataset.themeValue === theme;
        btn.setAttribute('aria-pressed', String(isActive));
      });
    };

    const current = document.documentElement.getAttribute('data-theme') || localStorage.getItem(KEY) || 'gold-night';
    updateActive(current);

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.dataset.themeValue;
        if (!selected) return;
        document.documentElement.setAttribute('data-theme', selected);
        localStorage.setItem(KEY, selected);
        updateActive(selected);
      });
    });
  })();
</script>

<footer class="px-4 pb-12 pt-8 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl rounded-3xl border p-8" style="background: var(--surface); border-color: var(--border); box-shadow: var(--shadow);">
    <div class="grid gap-8 md:grid-cols-4">
      <div>
        <h3 class="text-2xl font-bold text-main">BarberFlow</h3>
        <p class="mt-3 text-sm leading-relaxed text-subtle">Plataforma multi-barberia con temas configurables para que cada negocio tenga una identidad propia.</p>
      </div>

      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider" style="color: var(--secondary);">Producto</h4>
        <ul class="mt-4 space-y-2 text-sm text-subtle">
          <li><a href="#inicio" class="hover:text-[var(--secondary)]">HeroSection</a></li>
          <li><a href="#features" class="hover:text-[var(--secondary)]">FeaturesSection</a></li>
          <li><a href="#pricing" class="hover:text-[var(--secondary)]">PricingSection</a></li>
          <li><a href="#contact" class="hover:text-[var(--secondary)]">ContactSection</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider" style="color: var(--secondary);">Soporte</h4>
        <ul class="mt-4 space-y-2 text-sm text-subtle">
          <li><a href="#" class="hover:text-[var(--secondary)]">Centro de ayuda</a></li>
          <li><a href="#" class="hover:text-[var(--secondary)]">Documentacion</a></li>
          <li><a href="#" class="hover:text-[var(--secondary)]">Estado del servicio</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider" style="color: var(--secondary);">Legal</h4>
        <ul class="mt-4 space-y-2 text-sm text-subtle">
          <li><a href="#" class="hover:text-[var(--secondary)]">Terminos</a></li>
          <li><a href="#" class="hover:text-[var(--secondary)]">Privacidad</a></li>
          <li><a href="#" class="hover:text-[var(--secondary)]">Cookies</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t pt-5 text-sm text-subtle" style="border-color: var(--border);">
      <p>© 2026 BarberFlow. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

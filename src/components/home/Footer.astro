---
const helpPath = `${import.meta.env.BASE_URL}ayuda`;
const termsPath = `${import.meta.env.BASE_URL}terminos-de-uso`;
const dataTreatmentPath = `${import.meta.env.BASE_URL}tratamiento-de-datos`;
const privacyPath = `${import.meta.env.BASE_URL}privacidad`;
---

<footer class="landing-refinement px-4 pb-12 pt-8 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl rounded-3xl border p-8" style="background: var(--surface); border-color: var(--border); box-shadow: var(--shadow);">
    <div class="grid gap-8 md:grid-cols-4">
      <div>
        <h3 class="text-2xl font-bold text-main">BookSmart</h3>
        <p class="mt-3 text-sm leading-relaxed text-subtle">Plataforma de agendamiento con temas configurables para que cada negocio tenga una identidad propia.</p>
      </div>

      <div>
        <h4 class="accent-text text-sm font-bold uppercase tracking-wider">Producto</h4>
        <ul class="mt-4 space-y-2 text-sm text-subtle">
          <li><a href="#inicio" class="accent-link">Inicio</a></li>
          <li><a href="#features" class="accent-link">Lo que ofrecemos</a></li>
          <!-- <li><a href="#pricing" class="accent-link">Precios</a></li> -->
          <li><a href="#contact" class="accent-link">Contacto</a></li>
        </ul>
      </div>

      <div>
        <h4 class="accent-text text-sm font-bold uppercase tracking-wider">Soporte</h4>
        <ul class="mt-4 space-y-2 text-sm text-subtle">
          <li><a href={helpPath} class="accent-link">Centro de ayuda</a></li>
          <li><a href={`${import.meta.env.BASE_URL}documentacion`} class="accent-link">Documentación</a></li>
        </ul>
      </div>

      <div>
        <h4 class="accent-text text-sm font-bold uppercase tracking-wider">Legal</h4>
        <ul class="mt-4 space-y-2 text-sm text-subtle">
          <li><a href={termsPath} class="accent-link">Términos de uso</a></li>
          <li><a href={dataTreatmentPath} class="accent-link">Tratamiento de datos</a></li>
          <li><a href={privacyPath} class="accent-link">Privacidad</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t pt-5 text-sm text-subtle" style="border-color: var(--border);">
      <p>© 2026 BookSmart. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
